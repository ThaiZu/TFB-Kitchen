<style>
.sb-head,.sb-tools{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}.sb-card{padding:18px;margin:14px 0;border:1px solid #e7dfd6;border-radius:16px;background:#fff}.sb-head h1{font-size:1.4rem;margin:0}.sb-muted{color:#766f68}.sb-button{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:10px 14px;border:0;border-radius:10px;background:#8D1D2C;color:#fff;text-decoration:none;font-weight:700}.sb-secondary{background:#f4efe8;color:#8D1D2C}.sb-button:disabled{opacity:.5;cursor:not-allowed}.sb-scroll{overflow:auto}.sb-table{border-collapse:collapse;width:100%;min-width:630px}.sb-table th,.sb-table td{padding:12px 8px;border-bottom:1px solid #eee7e0;text-align:left}.sb-table th{background:#f4efe8}.sb-table input[type=number],.sb-search{min-height:44px;border:1px solid #d7d0c8;border-radius:9px;padding:8px;max-width:140px}.sb-search{max-width:100%;min-width:240px}.sb-table input[type=checkbox]{width:22px;height:22px;accent-color:#8D1D2C}.sb-table small{display:block}.sb-table tr[hidden]{display:none}.sb-ok{color:#24603a}.sb-warn{color:#8D1D2C}.sb-notice{padding:12px;background:#f4efe8;border-radius:10px;margin:12px 0}.sb-notice[hidden]{display:none}.sb-group td{font-weight:700;background:#f4efe8}.sb-actions{position:sticky;bottom:82px;z-index:5;box-shadow:0 -2px 10px #00000009}.sb-result{min-width:130px}.sb-table td:first-child{width:45px}@media(max-width:600px){.sb-card{padding:12px}.sb-head h1{font-size:1.2rem}.sb-search{width:100%}}
