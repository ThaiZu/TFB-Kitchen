{% extends 'layouts/base.twig' %}
{% block title %}{{ translations.deliveries_title }}{% endblock %}
{% block head %}<link rel="stylesheet" href="{{ ROOT }}/assets/css/deliveries.css?v=2">{% endblock %}
{% block content %}
<section class="dl-heading"><div><h1>{{ translations.deliveries_title }}</h1></div><a class="dl-button" href="{{ ROOT }}/deliveries">{{ translations.refresh_list }}</a></section>
{% if not available %}<p class="dl-notice" role="alert">{{ translations.unavailable }}</p>
{% elseif orders is empty %}<p class="dl-notice">{{ translations.no_orders }}</p>
{% else %}
<div class="dl-list" role="list" aria-label="{{ translations.deliveries_title }}">
{% for item in orders %}
<a class="dl-order" role="listitem" href="{{ ROOT }}/deliveries/{{ item.id }}">
    <span><strong>{{ item.supplier_name }}</strong><small>#{{ item.id }} · {{ attribute(translations, 'status_' ~ item.status)|default(item.status) }}</small></span>
    <span><small>{{ translations.delivery_date }}</small><strong>{{ item.delivery_date ? item.delivery_date|date('d.m.Y') : '—' }}</strong></span>
    <span><strong>{{ item.product_count }} {{ translations.products_count }}</strong><small>{{ translations.approximately }} {{ item.pack_count|number_format(2, ',', ' ') }} {{ translations.packs }}</small></span>
    <span class="dl-open">{{ translations.open_delivery }} →</span>
</a>
{% endfor %}
</div>
{% endif %}
{% endblock %}
