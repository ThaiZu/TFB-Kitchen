{% extends 'layouts/base.twig' %}
{% block title %}{{ translations.title }} · {{ translations.tab_tomorrow }}{% endblock %}
{% block head %}
<style>
.cp-head,.cp-dates,.cp-summary-top{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}.cp-head h1{font-size:1.4rem;margin:0}.cp-muted{color:#766f68}.cp-tabs{display:flex;gap:5px;padding:5px;margin:14px 0;background:#f4efe8;border-radius:12px}.cp-tabs a{flex:1;min-height:44px;display:flex;align-items:center;justify-content:center;border-radius:8px;color:#766f68;text-decoration:none;font-weight:700;text-align:center}.cp-tabs a.is-active{background:#fff;color:#8D1D2C;box-shadow:0 1px 4px #00000014}.cp-card{padding:16px;margin:14px 0;border:1px solid #e7dfd6;border-radius:16px;background:#fff}.cp-notice{padding:12px;border-radius:10px;margin:12px 0;background:#f4efe8}.cp-notice.cp-error{background:#fae9e9;color:#8D1D2C}.cp-notice.cp-ok{background:#e5f2e8;color:#24603a}.cp-notice[hidden]{display:none}.cp-list{display:grid;gap:10px}.cp-product{padding:14px;border:1px solid #e7dfd6;border-radius:14px;background:#fff}.cp-product.cp-stale{border-color:#8D1D2C}.cp-product-top{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}.cp-product-name{font-weight:800;line-height:1.25}.cp-product-meta,.cp-limit,.cp-readonly{font-size:.8rem;margin-top:4px}.cp-product-meta,.cp-readonly{color:#766f68}.cp-limit{color:#8D1D2C}.cp-fields{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:12px}.cp-label{display:block;font-size:.8rem;font-weight:700;margin:0 0 4px}.cp-input,.cp-select,.cp-textarea{width:100%;min-height:44px;border:1px solid #d7d0c8;border-radius:9px;padding:8px;background:#fff}.cp-textarea{min-height:72px}.cp-waste{margin-top:10px}.cp-confirm{display:flex;align-items:center;gap:8px;min-height:44px;margin-top:10px;font-weight:700}.cp-shortcuts{display:flex;gap:7px;flex-wrap:wrap;margin-top:10px}.cp-button{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:10px 14px;border:0;border-radius:10px;background:#8D1D2C;color:#fff;text-decoration:none;font-weight:700}.cp-button.cp-secondary{background:#f4efe8;color:#8D1D2C}.cp-button:disabled{opacity:.5;cursor:not-allowed}.cp-sticky{position:sticky;bottom:calc(var(--app-tabbar-h,72px) + 8px);z-index:4;box-shadow:0 -2px 10px #00000009}.cp-previous{display:grid;gap:8px}.cp-previous-line{padding:10px 0;border-bottom:1px solid #eee7e0}.cp-previous-line:last-child{border-bottom:0}.cp-previous-line b,.cp-previous-line small{display:block}@media(max-width:600px){.cp-card{padding:12px}.cp-head h1{font-size:1.2rem}.cp-fields{gap:7px}.cp-tabs a{font-size:.84rem}}
</style>
{% endblock %}
{% block content %}
<div class="cp-head"><div><h1>{{ translations.title }}</h1><p class="cp-muted">{{ translations.carryover_subtitle }}</p></div><a class="cp-button cp-secondary" href="{{ ROOT }}/inventory?tab=tomorrow">{{ translations.reload }}</a></div>
<nav class="cp-tabs" aria-label="{{ translations.title }}"><a href="{{ ROOT }}/inventory">{{ translations.tab_state }}</a><a href="{{ ROOT }}/inventory?tab=waste">{{ translations.tab_waste }}</a><a class="is-active" aria-current="page" href="{{ ROOT }}/inventory?tab=tomorrow">{{ translations.tab_tomorrow }}</a></nav>
<div id="cpNotice" class="cp-notice" role="status" aria-live="polite" hidden></div>
{% if not available %}<p class="cp-card cp-notice cp-error">{{ translations.carryover_unavailable }}</p>
{% else %}
{% if not has_shift %}<p class="cp-card cp-notice cp-error">{{ translations.shift_required }} <a href="{{ ROOT }}/checklist">{{ translations.open_shift }}</a></p>{% endif %}
<section class="cp-card"><div class="cp-dates"><span><b>{{ translations.carryover_source_date }}</b> <span id="cpSourceDate">{{ source_date }}</span></span><span><b>{{ translations.carryover_target_date }}</b> <span id="cpTargetDate">{{ target_date }}</span></span></div><p class="cp-muted mb-0 mt-2">{{ translations.carryover_date_hint }}</p></section>
<section id="cpProducts" class="cp-list" aria-live="polite"></section>
<section class="cp-card"><div class="cp-summary-top"><h2 class="h5 mb-0">{{ translations.carryover_summary }}</h2><span id="cpSummary" class="cp-muted"></span></div><p id="cpSummaryText" class="mb-0 mt-2"></p></section>
<section class="cp-card cp-sticky"><button id="cpSave" class="cp-button w-100" type="button" {% if not has_shift %}disabled{% endif %}>{{ translations.carryover_save }}</button></section>
<section class="cp-card"><h2 class="h5">{{ translations.carryover_previous }}</h2><div id="cpPrevious" class="cp-previous"></div></section>

<script>
(() => {
 const root={{ ROOT|json_encode|raw }}, messages={{ translations|json_encode(constant('JSON_HEX_TAG'))|raw }};
 let screen={{ {items: items, waste_reasons: waste_reasons, from_previous_day: from_previous_day, source_date: source_date, target_date: target_date, timezone: timezone, has_shift: has_shift, available: available}|json_encode(constant('JSON_HEX_TAG'))|raw }};
 const storageKey='kitchen-carryover-draft:'+root+':'+{{ shop_id|json_encode|raw }}+':'+(screen.source_date||'unknown');
 const list=document.getElementById('cpProducts'), previous=document.getElementById('cpPrevious'), save=document.getElementById('cpSave'), notice=document.getElementById('cpNotice');
 const uuid=()=>window.crypto?.randomUUID?crypto.randomUUID():('carryover-'+Date.now()+'-'+Math.random().toString(16).slice(2));
 const fresh=()=>({idempotency_key:uuid(),lines:{},attempted:false});let draft=fresh(),busy=false;
 try{const saved=JSON.parse(sessionStorage.getItem(storageKey));if(saved&&typeof saved.idempotency_key==='string'&&saved.lines&&typeof saved.lines==='object')draft=saved;}catch(_){}
 const persist=()=>sessionStorage.setItem(storageKey,JSON.stringify(draft));
 const changed=()=>{if(draft.attempted){draft.idempotency_key=uuid();draft.attempted=false;}persist();};
 const fmt=n=>Number(n).toLocaleString(undefined,{maximumFractionDigits:4});
 const reason=key=>(screen.waste_reasons||[]).find(r=>r.key===key);
 const pending=()=>screen.items.filter(i=>i.status==='needs_decision');
 const show=(text,type='')=>{notice.hidden=false;notice.textContent=text;notice.className='cp-notice '+(type?'cp-'+type:'');};
 function current(item){return draft.lines[item.id_product]||{carryover_quantity:'',waste_quantity:'',waste_reason:'',waste_comment:'',confirmed:false,expected_in_stock:String(item.in_stock),expected_movement_id:String(item.last_movement_id),stale:false};}
 function update(item, patch){const line={...current(item),...patch};line.expected_in_stock=String(item.in_stock);line.expected_movement_id=String(item.last_movement_id);draft.lines[item.id_product]=line;changed();return line;}
 function selectReasons(value){const select=document.createElement('select');select.className='cp-select';select.dataset.field='waste_reason';const empty=document.createElement('option');empty.value='';empty.textContent=messages.carryover_choose_reason;select.append(empty);(screen.waste_reasons||[]).forEach(r=>{const o=document.createElement('option');o.value=r.key;o.textContent=r.label;o.selected=value===r.key;select.append(o);return o;});return select;}
 function renderWasteFields(item,waste){waste.replaceChildren();const line=current(item),wasteQty=Number(line.waste_quantity||0);waste.hidden=wasteQty<=0;if(waste.hidden)return;const label=document.createElement('label');label.className='cp-label';label.textContent=messages.waste_reason;const select=selectReasons(line.waste_reason||'');select.addEventListener('change',()=>{update(item,{waste_reason:select.value,stale:false});renderWasteFields(item,waste);renderSummary();});waste.append(label,select);const selected=reason(line.waste_reason);if(selected?.comment_required||line.waste_comment){const commentLabel=document.createElement('label');commentLabel.className='cp-label';commentLabel.textContent=messages.waste_comment;const comment=document.createElement('textarea');comment.className='cp-textarea';comment.maxLength=500;comment.value=line.waste_comment||'';comment.addEventListener('input',()=>{update(item,{waste_comment:comment.value,stale:false});renderSummary();});waste.append(commentLabel,comment);}}
 function renderProducts(){list.replaceChildren();const items=screen.items||[];if(!items.length){const empty=document.createElement('p');empty.className='cp-card cp-muted';empty.textContent=messages.carryover_empty;list.append(empty);return;}items.forEach(item=>{
   const card=document.createElement('article');card.className='cp-product';const top=document.createElement('div');top.className='cp-product-top';const text=document.createElement('div');const name=document.createElement('div');name.className='cp-product-name';name.textContent=item.product_name||'—';const meta=document.createElement('div');meta.className='cp-product-meta';meta.textContent=item.in_stock===null?messages.carryover_current_unknown:(messages.carryover_current_stock+': '+fmt(item.in_stock)+' '+messages.waste_unit_piece);text.append(name,meta);top.append(text);card.append(top);
   if(item.status==='unsupported'){const limit=document.createElement('p');limit.className='cp-limit mb-0';limit.textContent=messages.carryover_unsupported;card.append(limit);list.append(card);return;}
   if(item.status==='settled'){const s=item.settlement||{};const read=document.createElement('p');read.className='cp-readonly mb-0';read.textContent=messages.carryover_settled+': '+fmt(s.carryover_quantity)+' '+messages.carryover_for_tomorrow+', '+fmt(s.waste_quantity)+' '+messages.carryover_to_waste+(s.waste_reason_label?' · '+s.waste_reason_label:'')+(s.waste_comment?' · '+s.waste_comment:'');card.append(read);if(s.state_changed_after_settlement){const changed=document.createElement('p');changed.className='cp-limit mb-0';changed.textContent=messages.carryover_changed_after;card.append(changed);}list.append(card);return;}
   const line=current(item);if(line.stale)card.classList.add('cp-stale');const waste=document.createElement('div');waste.className='cp-waste';const fields=document.createElement('div');fields.className='cp-fields';[['carryover_quantity',messages.carryover_for_tomorrow],['waste_quantity',messages.carryover_to_waste]].forEach(([field,label])=>{const wrap=document.createElement('div');const l=document.createElement('label');l.className='cp-label';l.textContent=label;const input=document.createElement('input');input.className='cp-input';input.type='number';input.min='0';input.step='1';input.inputMode='numeric';input.value=line[field]??'';input.addEventListener('input',()=>{update(item,{[field]:input.value,stale:false});if(field==='waste_quantity')renderWasteFields(item,waste);renderSummary();});wrap.append(l,input);fields.append(wrap);});card.append(fields);renderWasteFields(item,waste);card.append(waste);
   const wholeStock=String(Math.trunc(Number(item.in_stock)));const shortcuts=document.createElement('div');shortcuts.className='cp-shortcuts';const tomorrow=document.createElement('button');tomorrow.type='button';tomorrow.className='cp-button cp-secondary';tomorrow.textContent=messages.carryover_all_tomorrow;tomorrow.addEventListener('click',()=>{update(item,{carryover_quantity:wholeStock,waste_quantity:'0',waste_reason:'',waste_comment:'',confirmed:true,stale:false});renderProducts();renderSummary();});const discard=document.createElement('button');discard.type='button';discard.className='cp-button cp-secondary';discard.textContent=messages.carryover_all_waste;discard.addEventListener('click',()=>{update(item,{carryover_quantity:'0',waste_quantity:wholeStock,waste_reason:'',waste_comment:'',confirmed:true,stale:false});renderProducts();renderSummary();});shortcuts.append(tomorrow,discard);card.append(shortcuts);
   const confirm=document.createElement('label');confirm.className='cp-confirm';const check=document.createElement('input');check.type='checkbox';check.checked=Boolean(line.confirmed);check.addEventListener('change',()=>{update(item,{confirmed:check.checked,stale:false});renderSummary();});confirm.append(check,document.createTextNode(messages.carryover_confirm));card.append(confirm);if(line.stale){const stale=document.createElement('p');stale.className='cp-limit mb-0';stale.textContent=messages.carryover_reassess;card.append(stale);}list.append(card);
 });}
 function valid(item){const line=current(item),carry=String(line.carryover_quantity),waste=String(line.waste_quantity);const quantities=/^\d{1,8}$/.test(carry)&&/^\d{1,8}$/.test(waste)&&Number(carry)+Number(waste)===Number(item.in_stock);const selected=reason(line.waste_reason);return Boolean(line.confirmed)&&!line.stale&&quantities&&(Number(waste)===0||Boolean(selected)&&(!selected.comment_required||String(line.waste_comment||'').trim()));}
 function renderSummary(){const items=pending(),validCount=items.filter(valid).length;let carry=0,waste=0;items.forEach(i=>{const l=current(i);carry+=Number(l.carryover_quantity||0);waste+=Number(l.waste_quantity||0);});document.getElementById('cpSummary').textContent=validCount+'/'+items.length;document.getElementById('cpSummaryText').textContent=messages.carryover_summary_text.replace('%carry%',fmt(carry)).replace('%waste%',fmt(waste)).replace('%date%',screen.target_date||'');}
 function renderPrevious(){previous.replaceChildren();if(!(screen.from_previous_day||[]).length){const empty=document.createElement('p');empty.className='cp-muted mb-0';empty.textContent=messages.carryover_previous_empty;previous.append(empty);return;}(screen.from_previous_day||[]).forEach(line=>{const row=document.createElement('div');row.className='cp-previous-line';const title=document.createElement('b');title.textContent=line.product_name+' · '+fmt(line.carryover_quantity)+' '+messages.waste_unit_piece;const sub=document.createElement('small');sub.className='cp-muted';sub.textContent=messages.carryover_from_previous.replace('%date%',line.source_date);row.append(title,sub);previous.append(row);});}
 function payload(){return {idempotency_key:draft.idempotency_key,lines:pending().map(item=>{const l=current(item);return {id_product:Number(item.id_product),carryover_quantity:String(l.carryover_quantity),waste_quantity:String(l.waste_quantity),waste_reason:l.waste_reason||null,waste_comment:l.waste_comment||null,expected_in_stock:String(l.expected_in_stock),expected_movement_id:String(l.expected_movement_id)};})};}
 async function refresh(conflict=false){try{const response=await fetch(root+'/inventory/carryover-data',{credentials:'same-origin',headers:{'X-Requested-With':'XMLHttpRequest'}});const data=await response.json();if(response.ok&&data.success&&data.data){if(conflict)Object.values(draft.lines).forEach(l=>l.stale=true);screen=data.data;renderProducts();renderSummary();renderPrevious();}}catch(_){}}
 save.addEventListener('click',async()=>{if(busy)return;if(!screen.has_shift){show(messages.shift_required,'error');return;}if(!pending().length){show(messages.carryover_nothing,'error');return;}if(!pending().every(valid)){show(messages.carryover_invalid,'error');return;}busy=true;save.disabled=true;draft.attempted=true;persist();try{const response=await fetch(root+'/inventory/carryover',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},body:JSON.stringify(payload())});const data=await response.json();if(!response.ok||!data.success){if(data.reason==='conflict'){show(messages.carryover_conflict,'error');await refresh(true);}else show(messages[data.reason]||messages.carryover_failed,'error');return;}const warnings=(data.data?.items||[]).filter(i=>i.reservation_warning);draft=fresh();sessionStorage.removeItem(storageKey);show(warnings.length?messages.carryover_saved_warning.replace('%s',warnings.map(i=>i.reservation_shortfall_quantity).join(', ')):messages.carryover_saved,warnings.length?'error':'ok');await refresh();}catch(_){show(messages.carryover_network,'error');}finally{busy=false;save.disabled=!screen.has_shift;}});
 renderProducts();renderSummary();renderPrevious();
})();
</script>
{% endif %}
{% endblock %}
