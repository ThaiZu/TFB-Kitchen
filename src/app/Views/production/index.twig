{# production/index.twig
   Le plan de production du jour, tenu sur une tablette posée près du four.

   Trois états bien distincts, et c'est le cœur de l'écran :
     • le plan n'est pas servi par l'API      → on le dit
     • le plan est servi mais vide            → « rien de prévu »
     • le plan est servi et rempli            → les lignes, groupées par statut
   Confondre les deux premiers ferait croire un matin qu'il n'y a rien à
   produire. Voir docs/ENDPOINTS_PRODUCTION.md. #}
{% extends "layouts/base.twig" %}
{% import "components/_icons.twig" as icons %}

{% block title %}{{ translations.production_title | default('Production du jour') }}{% endblock %}

{% block head %}
<style>
    /* ── Barre de date ───────────────────────────────────────────────────
       La cuisine regarde surtout aujourd'hui, parfois la veille (ce qui
       n'est pas sorti) et le lendemain (ce qu'il faut préparer ce soir).
       Deux flèches larges plutôt qu'un calendrier à ouvrir. */
    .pr-datebar { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .pr-datenav {
        width: 48px; height: 48px; flex: 0 0 auto;
        display: inline-flex; align-items: center; justify-content: center;
        border: 1px solid var(--c-line-2, rgba(36,26,22,.14));
        border-radius: var(--r-md, 13px);
        background: #fff; color: var(--c-ink, #241f1c);
        text-decoration: none;
        -webkit-tap-highlight-color: transparent;
    }
    .pr-datenav:active { background: var(--c-bg-2, #F4EFE8); }
    .pr-datefield { flex: 1 1 180px; min-width: 150px; }
    .pr-datefield input { min-height: 48px; }
    .pr-today {
        min-height: 48px; padding: 0 16px; flex: 0 0 auto;
        display: inline-flex; align-items: center;
        border-radius: var(--r-md, 13px);
        text-decoration: none; font-weight: 700; font-size: .88rem;
    }

    /* ── Bandeau de synthèse ─────────────────────────────────────────── */
    .pr-sum { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .pr-stat {
        flex: 1 1 90px; min-width: 84px; text-align: center;
        padding: 10px 8px; border-radius: var(--r-md, 13px);
        background: var(--c-bg-2, #F4EFE8);
    }
    .pr-stat b { display: block; font-size: 1.6rem; font-weight: 800; line-height: 1.05; }
    .pr-stat span {
        display: block; font-size: .7rem; letter-spacing: .04em;
        text-transform: uppercase; color: var(--c-muted, #7a7168); margin-top: 2px;
    }
    .pr-stat-todo b        { color: var(--c-primary, #8D1D2C); }
    .pr-stat-progress b    { color: #C17A2A; }
    .pr-stat-done b        { color: #2D7A3E; }
    .pr-sum-bar {
        height: 8px; border-radius: 4px; background: #e6ded3;
        overflow: hidden; margin-top: 14px;
    }
    .pr-sum-bar > span { display: block; height: 100%; background: #2D7A3E; border-radius: 4px; }
    .pr-sum-pct { font-size: .82rem; color: var(--c-muted, #7a7168); margin: 8px 0 0; }
    .pr-sum-pct b { color: var(--c-ink, #241f1c); font-weight: 800; }

    /* ── Groupes ─────────────────────────────────────────────────────── */
    .pr-group { margin-top: 22px; }
    .pr-group-title {
        display: flex; align-items: center; gap: 8px;
        font-size: .78rem; font-weight: 800; letter-spacing: .06em;
        text-transform: uppercase; color: var(--c-muted, #7a7168);
        margin: 0 0 10px 2px;
    }
    .pr-group-count {
        min-width: 22px; height: 22px; padding: 0 7px; border-radius: 999px;
        background: var(--c-bg-2, #F4EFE8); color: var(--c-ink, #241f1c);
        font-size: .72rem; line-height: 22px; text-align: center;
    }

    /* ── Tuile de production ─────────────────────────────────────────────
       Même grammaire que les tuiles de tâche des checklists : liseré à
       gauche pour l'état, titre large, chiffres, un geste principal en
       pleine largeur et haut de 48 px. */
    .pr-list { display: flex; flex-direction: column; gap: 10px; }
    .pr-item {
        background: var(--c-surface, #fff);
        border: 1px solid var(--c-line, rgba(36,26,22,.09));
        border-left: 4px solid var(--c-muted, #7a7168);
        border-radius: var(--r-lg, 18px);
        box-shadow: var(--sh-2);
        padding: 14px 16px;
    }
    .pr-item.is-todo        { border-left-color: var(--c-primary, #8D1D2C); }
    .pr-item.is-in_progress { border-left-color: #C17A2A; }
    .pr-item.is-done        { border-left-color: #2D7A3E; background: #fcfbf9; }

    .pr-head { display: flex; align-items: flex-start; gap: 12px; }
    .pr-thumb {
        width: 54px; height: 54px; flex: 0 0 auto;
        border-radius: var(--r-md, 13px); object-fit: cover;
        background: var(--c-bg-2, #F4EFE8);
        display: flex; align-items: center; justify-content: center;
        color: var(--c-muted, #7a7168);
    }
    .pr-ttl { flex: 1; min-width: 0; }
    .pr-name {
        margin: 0; font-size: 1.05rem; font-weight: 700; line-height: 1.3;
        color: var(--c-ink, #241f1c); overflow-wrap: anywhere;
    }
    .pr-sub {
        margin: 3px 0 0; font-size: .8rem; color: var(--c-muted, #7a7168);
        display: flex; flex-wrap: wrap; align-items: center; gap: 4px 10px;
    }
    .pr-sub span { display: inline-flex; align-items: center; gap: 4px; }
    .pr-badge {
        flex: 0 0 auto; border-radius: 999px; padding: 5px 11px;
        font-size: .74rem; font-weight: 700; white-space: nowrap;
    }
    .pr-badge-todo        { background: #e2e3e5; color: #41464b; }
    .pr-badge-in_progress { background: #fdf0dd; color: #8a5312; }
    .pr-badge-done        { background: #d1e7dd; color: #0f5132; }

    /* Les chiffres sont ce qu'on vient lire de loin : gros, alignés. */
    .pr-count {
        display: flex; align-items: baseline; gap: 6px; flex-wrap: wrap;
        margin: 13px 0 0;
    }
    .pr-count-done    { font-size: 1.7rem; font-weight: 800; line-height: 1; color: var(--c-ink, #241f1c); }
    .pr-count-sep     { font-size: 1.15rem; color: var(--c-muted, #7a7168); }
    .pr-count-planned { font-size: 1.15rem; font-weight: 700; color: var(--c-muted, #7a7168); }
    .pr-count-unit    { font-size: .84rem; color: var(--c-muted, #7a7168); }
    .pr-count-rest {
        margin-left: auto; font-size: .8rem; color: var(--c-muted, #7a7168);
        background: var(--c-bg-2, #F4EFE8);
        border: 1px solid var(--c-line, rgba(36,26,22,.09));
        border-radius: 999px; padding: 4px 11px;
    }
    .pr-count-rest b { color: var(--c-ink, #241f1c); font-weight: 800; }

    .pr-bar { height: 6px; border-radius: 3px; background: #e6ded3; overflow: hidden; margin-top: 9px; }
    .pr-bar > span { display: block; height: 100%; border-radius: 3px; background: #C17A2A; }
    .pr-item.is-done .pr-bar > span { background: #2D7A3E; }

    .pr-note {
        display: flex; gap: 7px; margin: 11px 0 0;
        font-size: .86rem; color: #5b524a; line-height: 1.5;
    }
    .pr-note .lc-icon { flex-shrink: 0; margin-top: 3px; color: var(--c-muted, #7a7168); }

    .pr-actions { display: flex; gap: 9px; margin-top: 13px; }
    .pr-btn {
        flex: 1; min-height: 48px;
        display: inline-flex; align-items: center; justify-content: center; gap: 8px;
        border: 0; border-radius: var(--r-md, 13px);
        font-family: inherit; font-size: .95rem; font-weight: 700; cursor: pointer;
        text-decoration: none; -webkit-tap-highlight-color: transparent;
    }
    .pr-btn:active { transform: scale(.99); }
    .pr-btn[disabled] { opacity: .55; cursor: default; }
    .pr-btn-start  { background: var(--c-primary, #8D1D2C); color: #fff; }
    .pr-btn-start:hover  { background: #74101f; color: #fff; }
    .pr-btn-finish { background: #2D7A3E; color: #fff; box-shadow: 0 8px 18px -10px rgba(45,122,62,.6); }
    .pr-btn-finish:hover { background: #256633; color: #fff; }
    /* « +1 » est le geste le plus répété du service : il reste large et à
       gauche, sous la main qui tient la plaque. */
    .pr-btn-inc {
        flex: 0 0 92px;
        background: var(--c-secondary, #F2C9A0); color: var(--c-on-abricot, #4a2c12);
        font-size: 1.05rem; font-weight: 800;
    }
    .pr-btn-sheet {
        flex: 0 0 48px; padding: 0;
        background: #fff; color: var(--c-primary, #8D1D2C);
        border: 1px solid var(--c-line-2, rgba(36,26,22,.14));
    }
    .pr-btn-sheet:hover { background: var(--c-primary-soft, #f4dfe2); color: var(--c-primary, #8D1D2C); }

    .pr-done-info {
        display: flex; flex-wrap: wrap; gap: 7px; margin-top: 12px;
        font-size: .78rem; color: var(--c-muted, #7a7168);
    }
    .pr-done-info span {
        display: inline-flex; align-items: center; gap: 5px;
        background: var(--c-bg-2, #F4EFE8);
        border: 1px solid var(--c-line, rgba(36,26,22,.09));
        border-radius: 999px; padding: 4px 11px;
    }

    /* ── États vides ─────────────────────────────────────────────────── */
    .pr-state { text-align: center; padding: 40px 22px; }
    .pr-state .lc-icon { color: var(--c-muted, #7a7168); opacity: .45; }
    .pr-state p { margin: 14px auto 0; max-width: 46ch; color: var(--c-muted, #7a7168); line-height: 1.6; }
</style>
{% endblock %}

{% block page_heading %}
    <div class="page-heading">
        <h3>{{ translations.production_title | default('Production du jour') }}</h3>
        <p class="text-subtitle text-muted">
            {{ translations.production_subtitle | default("Ce qu'il y a à produire aujourd'hui, dans l'ordre") }}
        </p>
    </div>
{% endblock %}

{% block content %}

    {# ── Date ── #}
    <div class="card mb-3">
        <div class="card-body">
            <form method="GET" action="{{ ROOT }}/production" class="pr-datebar" id="prDateForm">
                <a class="pr-datenav"
                   href="{{ ROOT }}/production?date={{ selected_date|date_modify('-1 day')|date('Y-m-d') }}"
                   aria-label="{{ translations.prod_prev_day | default('Jour précédent') }}">
                    {{ icons.svg('chevron-left', 20) }}
                </a>

                <div class="pr-datefield">
                    <label for="prDate" class="visually-hidden">{{ translations.prod_date | default('Date') }}</label>
                    <input type="date" id="prDate" name="date" class="form-control" value="{{ selected_date }}">
                </div>

                <a class="pr-datenav"
                   href="{{ ROOT }}/production?date={{ selected_date|date_modify('+1 day')|date('Y-m-d') }}"
                   aria-label="{{ translations.prod_next_day | default('Jour suivant') }}">
                    {{ icons.svg('chevron-right', 20) }}
                </a>

                {% if selected_date != today %}
                    <a class="pr-today btn btn-outline-primary" href="{{ ROOT }}/production">
                        {{ translations.prod_today | default("Aujourd'hui") }}
                    </a>
                {% endif %}

                {# Sans JavaScript, le champ date a besoin d'un bouton pour partir. #}
                <noscript>
                    <button type="submit" class="pr-today btn btn-primary">
                        {{ translations.prod_apply | default('Afficher') }}
                    </button>
                </noscript>
            </form>
        </div>
    </div>

    {% if not plan_available %}

        {# L'API ne sert pas encore le plan. On le dit en toutes lettres : une
           liste vide laisserait croire qu'il n'y a rien à produire. #}
        <div class="card">
            <div class="card-body pr-state">
                {{ icons.svg('package', 42) }}
                <p>{{ translations.prod_not_served | default("Le plan de production n'est pas encore servi par l'API.") }}</p>
            </div>
        </div>

    {% elseif items is empty %}

        <div class="card">
            <div class="card-body pr-state">
                {{ icons.svg('check-check', 42) }}
                <p>{{ translations.prod_empty | default('Aucune production prévue pour cette date.') }}</p>
            </div>
        </div>

    {% else %}

        {# ── Synthèse ── #}
        <div class="card mb-3">
            <div class="card-body">
                <div class="pr-sum">
                    <div class="pr-stat pr-stat-todo">
                        <b>{{ summary.todo }}</b><span>{{ translations.prod_todo | default('À faire') }}</span>
                    </div>
                    <div class="pr-stat pr-stat-progress">
                        <b>{{ summary.in_progress }}</b><span>{{ translations.prod_in_progress | default('En cours') }}</span>
                    </div>
                    <div class="pr-stat pr-stat-done">
                        <b>{{ summary.done }}</b><span>{{ translations.prod_done | default('Terminé') }}</span>
                    </div>
                </div>

                <div class="pr-sum-bar" aria-hidden="true">
                    <span style="width: {{ summary.percent }}%"></span>
                </div>
                <p class="pr-sum-pct">
                    {% if summary.todo == 0 and summary.in_progress == 0 %}
                        {{ translations.prod_all_done | default('Tout est produit') }}
                    {% else %}
                        {{ translations.prod_progress | default('Avancement') }} <b>{{ summary.percent }}%</b>
                    {% endif %}
                </p>
            </div>
        </div>

        {# ── Les trois groupes, dans l'ordre où la cuisine les lit ── #}
        {% set blocks = [
            { key: 'in_progress', label: translations.prod_in_progress | default('En cours') },
            { key: 'todo',        label: translations.prod_todo        | default('À faire') },
            { key: 'done',        label: translations.prod_done        | default('Terminé') }
        ] %}

        {% for b in blocks %}
            {% set rows = groups[b.key] %}
            {% if rows is not empty %}
                <section class="pr-group">
                    <h2 class="pr-group-title">
                        {{ b.label }}<span class="pr-group-count">{{ rows|length }}</span>
                    </h2>

                    <div class="pr-list">
                        {% for it in rows %}
                            {% set st = it.status|lower %}
                            <article class="pr-item is-{{ st }}"
                                     data-item-id="{{ it.id }}"
                                     data-status="{{ it.status }}"
                                     data-done="{{ it.quantityDone }}"
                                     data-planned="{{ it.quantityPlanned }}">

                                <div class="pr-head">
                                    {% if it.hasMainPhoto %}
                                        <img class="pr-thumb" src="{{ it.mainPhotoUrl }}" alt="" loading="lazy">
                                    {% else %}
                                        <span class="pr-thumb" aria-hidden="true">{{ icons.svg('package', 22) }}</span>
                                    {% endif %}

                                    <div class="pr-ttl">
                                        <h3 class="pr-name">{{ it.name | default('—') }}</h3>
                                        <p class="pr-sub">
                                            {% if it.slot %}
                                                <span>{{ icons.svg('clock', 14) }}{{ it.slot|slice(0,5) }}</span>
                                            {% endif %}
                                            {% if it.categoryName %}
                                                <span>{{ it.categoryName }}</span>
                                            {% endif %}
                                        </p>
                                    </div>

                                    <span class="pr-badge pr-badge-{{ st }}">
                                        {% if it.isDone %}{{ translations.prod_done | default('Terminé') }}
                                        {% elseif it.isInProgress %}{{ translations.prod_in_progress | default('En cours') }}
                                        {% else %}{{ translations.prod_todo | default('À faire') }}{% endif %}
                                    </span>
                                </div>

                                <div class="pr-count">
                                    <span class="pr-count-done" data-role="done">{{ it.quantityDone|number_format(0, ',', ' ') }}</span>
                                    <span class="pr-count-sep">/</span>
                                    <span class="pr-count-planned">{{ it.quantityPlanned|number_format(0, ',', ' ') }}</span>
                                    {% if it.unitName %}<span class="pr-count-unit">{{ it.unitName }}</span>{% endif %}
                                    {% if not it.isDone %}
                                        <span class="pr-count-rest">
                                            {{ translations.prod_remaining | default('Reste') }}
                                            <b data-role="rest">{{ it.quantityRemaining|number_format(0, ',', ' ') }}</b>
                                        </span>
                                    {% endif %}
                                </div>

                                <div class="pr-bar" aria-hidden="true">
                                    <span data-role="bar" style="width: {{ it.progressPercent }}%"></span>
                                </div>

                                {% if it.note %}
                                    <p class="pr-note">{{ icons.svg('message-square', 15) }}{{ it.note }}</p>
                                {% endif %}

                                {% if it.isDone %}
                                    <div class="pr-done-info">
                                        {% if it.completedAt %}
                                            <span>{{ icons.svg('check', 13) }}{{ it.completedAt|slice(11,5) }}</span>
                                        {% endif %}
                                        {% if it.completedBy %}
                                            <span>{{ icons.svg('user', 13) }}{{ it.completedBy }}</span>
                                        {% endif %}
                                        {% if it.idProduct %}
                                            <a class="pr-btn pr-btn-sheet" style="flex:0 0 auto;min-height:30px;padding:0 11px;font-size:.78rem;"
                                               href="{{ ROOT }}/knowledge/products/{{ it.idProduct }}">
                                                {{ icons.svg('notebook', 14) }}
                                                {{ translations.prod_open_sheet | default('Fiche technique') }}
                                            </a>
                                        {% endif %}
                                    </div>
                                {% else %}
                                    <div class="pr-actions">
                                        {% if it.isInProgress %}
                                            <button type="button" class="pr-btn pr-btn-inc" data-action="inc">+1</button>
                                            <button type="button" class="pr-btn pr-btn-finish" data-action="finish">
                                                {{ icons.svg('check', 18) }}{{ translations.prod_finish | default('Terminer') }}
                                            </button>
                                        {% else %}
                                            <button type="button" class="pr-btn pr-btn-start" data-action="start">
                                                {{ icons.svg('play', 16) }}{{ translations.prod_start | default('Démarrer') }}
                                            </button>
                                        {% endif %}

                                        {% if it.idProduct %}
                                            <a class="pr-btn pr-btn-sheet"
                                               href="{{ ROOT }}/knowledge/products/{{ it.idProduct }}"
                                               aria-label="{{ translations.prod_open_sheet | default('Fiche technique') }}"
                                               title="{{ translations.prod_open_sheet | default('Fiche technique') }}">
                                                {{ icons.svg('notebook', 19) }}
                                            </a>
                                        {% endif %}
                                    </div>
                                {% endif %}
                            </article>
                        {% endfor %}
                    </div>
                </section>
            {% endif %}
        {% endfor %}

    {% endif %}

{% endblock %}

{% block scripts %}
<script>
(function () {
    // Changer de date part tout seul ; le bouton reste dans <noscript>.
    var f = document.getElementById('prDateForm');
    var d = document.getElementById('prDate');
    if (f && d) d.addEventListener('change', function () { f.submit(); });
})();
</script>

{# ── Avancement ─────────────────────────────────────────────────────────
   Trois gestes, un seul appel : PATCH /ajax/production/{id}.

   Le serveur arbitre — deux tablettes peuvent pousser en même temps — donc
   on réaffiche ce qu'il renvoie plutôt que ce qu'on croit avoir fait. Tant
   que seule la quantité bouge, la tuile se met à jour sur place : recharger
   la page à chaque « +1 » ferait perdre sa ligne au milieu du service. Si le
   statut change, la ligne doit changer de groupe : là, on recharge.
   ──────────────────────────────────────────────────────────────────── #}
<script>
(function () {
    var ROOT  = {{ ROOT | json_encode | raw }};
    var ERROR = {{ (translations.prod_update_error | default("La mise à jour n'a pas pu être enregistrée.")) | json_encode | raw }};

    function payloadFor(action, card) {
        var done    = parseFloat(card.dataset.done || '0');
        var planned = parseFloat(card.dataset.planned || '0');
        if (action === 'start')  return { status: 'IN_PROGRESS' };
        if (action === 'inc')    return { quantity_done: Math.min(done + 1, planned > 0 ? planned : done + 1) };
        if (action === 'finish') return { status: 'DONE', quantity_done: planned };
        return null;
    }

    function repaint(card, item) {
        var planned = parseFloat(item.quantity_planned != null ? item.quantity_planned : card.dataset.planned) || 0;
        var done    = parseFloat(item.quantity_done != null ? item.quantity_done : card.dataset.done) || 0;

        card.dataset.done = done;
        card.dataset.planned = planned;

        var elDone = card.querySelector('[data-role="done"]');
        var elRest = card.querySelector('[data-role="rest"]');
        var elBar  = card.querySelector('[data-role="bar"]');
        if (elDone) elDone.textContent = done;
        if (elRest) elRest.textContent = Math.max(0, planned - done);
        if (elBar)  elBar.style.width = (planned > 0 ? Math.min(100, Math.round(done / planned * 100)) : 0) + '%';
    }

    document.addEventListener('click', function (e) {
        var btn = e.target.closest('.pr-btn[data-action]');
        if (!btn) return;

        var card = btn.closest('.pr-item');
        if (!card || !card.dataset.itemId) return;

        var body = payloadFor(btn.dataset.action, card);
        if (!body) return;

        btn.disabled = true;

        fetch(ROOT + '/ajax/production/' + card.dataset.itemId, {
            method:      'PATCH',
            headers:     { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            credentials: 'same-origin',
            body:        JSON.stringify(body)
        })
        .then(function (r) { return r.json().catch(function () { return null; }); })
        .then(function (res) {
            if (!res || !res.success) {
                showSnack(false, ERROR);
                btn.disabled = false;
                return;
            }
            var item = res.data || {};
            // Le statut renvoyé fait autorité : s'il a changé, la ligne
            // appartient à un autre groupe et la page doit se relire.
            if (item.status && item.status !== card.dataset.status) {
                window.location.reload();
                return;
            }
            repaint(card, item);
            btn.disabled = false;
        })
        .catch(function () {
            showSnack(false, ERROR);
            btn.disabled = false;
        });
    });
})();
</script>
{% endblock %}
