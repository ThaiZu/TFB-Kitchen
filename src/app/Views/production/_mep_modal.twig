{# production/_mep_modal.twig — validation de la mise en place.

   Ligne par ligne, avec la quantité éditable : on avait prévu 120 croissants,
   il en sort 118. C'est le chiffre réel qui devient le stock de départ — s'il
   est faux, l'écart se propage dans toutes les prévisions de la journée.

   Une ligne peut être écartée plutôt que mise à zéro : « pas produit » et
   « produit zéro » ne racontent pas la même chose au serveur. #}
{% import "components/_icons.twig" as icons %}

{% set pending_lines = mep_available ? mep_lines|filter(l => l.isPending) : [] %}

{% if pending_lines is not empty %}
<div class="modal fade" id="mepModal" tabindex="-1" aria-labelledby="mepModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="mepModalLabel">
                    {{ translations.mep_modal_title | default('Valider la mise en place') }}
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        aria-label="{{ translations.mep_cancel | default('Annuler') }}"></button>
            </div>

            <div class="modal-body">
                <p class="text-muted small mb-3">
                    {{ translations.mep_modal_hint | default('Corrigez les quantités réellement obtenues.') }}
                </p>

                <div id="mepLines">
                    {% for l in pending_lines %}
                        <div class="mepm-line" data-line-id="{{ l.id }}">
                            <span class="mepm-txt">
                                <span class="mepm-name">{{ l.name | default('—') }}</span>
                                <span class="mepm-planned">
                                    {{ translations.mep_planned | default('Prévu') }}
                                    {{ l.quantityPlanned|number_format(0, ',', ' ') }}{{ l.unitName ? ' ' ~ l.unitName : '' }}
                                </span>
                            </span>
                            <input type="number"
                                   class="form-control mepm-qty"
                                   inputmode="numeric"
                                   min="0"
                                   step="1"
                                   value="{{ l.defaultQuantity|number_format(0, '.', '') }}"
                                   aria-label="{{ translations.mep_real | default('Réel') }} — {{ l.name }}">
                            <button type="button" class="mepm-skip"
                                    aria-pressed="false"
                                    title="{{ translations.mep_skip | default('Écarter') }}"
                                    aria-label="{{ translations.mep_skip | default('Écarter') }}">
                                {{ icons.svg('x', 18) }}
                            </button>
                        </div>
                    {% endfor %}
                </div>

                <div id="mepAlert" class="alert mt-3 d-none"></div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    {{ translations.mep_cancel | default('Annuler') }}
                </button>
                <button type="button" class="btn btn-primary" id="mepConfirmBtn">
                    <span id="mepSpinner" class="spinner-border spinner-border-sm me-1 d-none"></span>
                    {{ translations.mep_confirm | default('Valider et mettre en vente') }}
                </button>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    var openBtn = document.getElementById('mepOpenBtn');
    var modalEl = document.getElementById('mepModal');
    if (!openBtn || !modalEl || typeof bootstrap === 'undefined') return;

    var modal   = new bootstrap.Modal(modalEl);
    var confirm = document.getElementById('mepConfirmBtn');
    var spinner = document.getElementById('mepSpinner');
    var alertEl = document.getElementById('mepAlert');

    var URL  = {{ ROOT | json_encode | raw }} + '/ajax/production/mep/validate';
    var DATE = {{ selected_date | json_encode | raw }};
    var MSG  = {
        error:   {{ (translations.mep_error   | default("La validation n'a pas pu être enregistrée.")) | json_encode | raw }},
        success: {{ (translations.mep_success | default('MEP validée : les produits sont en vente.')) | json_encode | raw }}
    };

    openBtn.addEventListener('click', function () { modal.show(); });

    // Écarter une ligne : elle part en `skipped` plutôt qu'en quantité nulle.
    document.addEventListener('click', function (e) {
        var b = e.target.closest('.mepm-skip');
        if (!b) return;
        var line = b.closest('.mepm-line');
        var on   = !line.classList.contains('is-skipped');
        line.classList.toggle('is-skipped', on);
        b.classList.toggle('is-on', on);
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
        var qty = line.querySelector('.mepm-qty');
        if (qty) qty.disabled = on;
    });

    confirm.addEventListener('click', function () {
        alertEl.classList.add('d-none');

        var lines = Array.prototype.map.call(
            document.querySelectorAll('#mepLines .mepm-line'),
            function (line) {
                var skipped = line.classList.contains('is-skipped');
                var qty     = line.querySelector('.mepm-qty');
                return {
                    id:       parseInt(line.dataset.lineId, 10),
                    quantity: skipped ? 0 : Math.max(0, parseFloat(qty && qty.value) || 0),
                    skipped:  skipped
                };
            }
        );

        spinner.classList.remove('d-none');
        confirm.disabled = true;

        fetch(URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            credentials: 'same-origin',
            body: JSON.stringify({ date: DATE, lines: lines })
        })
        .then(function (r) { return r.json().catch(function () { return null; }); })
        .then(function (res) {
            if (!res || !res.success) {
                alertEl.className = 'alert alert-danger mt-3';
                alertEl.textContent = MSG.error;
                alertEl.classList.remove('d-none');
                return;
            }
            modal.hide();
            showSnack(true, MSG.success);
            window.location.reload();
        })
        .catch(function () {
            alertEl.className = 'alert alert-danger mt-3';
            alertEl.textContent = MSG.error;
            alertEl.classList.remove('d-none');
        })
        .finally(function () {
            spinner.classList.add('d-none');
            confirm.disabled = false;
        });
    });
})();
</script>
{% endif %}
