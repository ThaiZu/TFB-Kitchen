{# production/_period.twig — une période de la journée.

   En haut, la MEP : c'est la première action du matin, et rien ne se vend
   avant elle. En dessous, les produits de la période, groupés par catégorie.

   Reçoit du contrôleur : mep_available, mep_status, mep_lines, mep_prepared_at,
   products_available, groups. #}
{% import "components/_icons.twig" as icons %}

{# Rappel de MEP en attente. La validation elle-même vit dans l'onglet MEP :
   ici on ne fait que signaler, parce qu'une période dont la MEP n'est pas
   validée n'a rien en vente, et que l'écran ne doit pas laisser le découvrir
   à la caisse. #}
{% if mep_available and mep_pending_count > 0 %}
    <a href="{{ ROOT }}/production?view=mep&mep=morning" class="mep-banner d-block text-decoration-none mb-3">
        <h2>{{ translations.mep_banner_title | default('MEP de la veille à valider') }}</h2>
        <p>{{ translations.mep_banner_text | default("Tant que la MEP n'est pas validée, la caisse ne peut pas vendre ces produits.") }}</p>
        <span class="mep-banner-btn">
            {{ icons.svg('check-check', 19) }}
            {{ translations.mep_go | default('Aller à la MEP') }}
            <span class="badge bg-light text-dark">{{ mep_pending_count }}</span>
        </span>
    </a>
{% endif %}

{# ── Produits de la période ── #}
{% if not products_available %}
    <div class="card">
        <div class="card-body pr-state">
            {{ icons.svg('package', 38) }}
            <p>{{ translations.prod_catalog_not_served | default("Le catalogue de production n'est pas encore servi par l'API.") }}</p>
        </div>
    </div>
{% elseif groups is empty %}
    <div class="card">
        <div class="card-body pr-state">
            {{ icons.svg('package', 38) }}
            <p>{{ translations.prod_no_products | default('Aucun produit déclaré pour cette période.') }}</p>
        </div>
    </div>
{% else %}
    {% for category, items in groups %}
        <section class="pr-cat">
            <h2 class="pr-cat-title">
                {{ category }}<span class="pr-cat-count">{{ items|length }}</span>
            </h2>

            <div class="pr-rows">
                {% for p in items %}
                    {# Le statut de MEP se lit sur la ligne du produit, pas dans
                       une seconde liste que personne ne rapprocherait. La
                       recherche est directe : une période compte quelques
                       dizaines de lignes, pas des milliers. #}
                    {% set line = mep_lines|filter(l => l.idProduct == p.idProduct)|first|default(null) %}
                    {% set state = line is null ? '' : (line.isValidated ? 'is-mep-validated' : (line.isPending ? 'is-mep-pending' : '')) %}

                    <a class="pr-row {{ state }}"
                       href="{{ p.idProduct ? ROOT ~ '/knowledge/products/' ~ p.idProduct : '#' }}">
                        {% if p.hasMainPhoto %}
                            <img class="pr-thumb" src="{{ p.mainPhotoUrl }}" alt="" loading="lazy">
                        {% else %}
                            <span class="pr-thumb" aria-hidden="true">{{ icons.svg('package', 20) }}</span>
                        {% endif %}

                        <span class="pr-row-txt">
                            <span class="pr-row-name">{{ p.name | default('—') }}</span>
                            <span class="pr-row-meta">
                                {% if p.hasBatchSize %}
                                    <span>{{ icons.svg('layers', 13) }}
                                        {{ translations.prod_batch | default('Fournée') }}
                                        {{ p.batchSize|number_format(0, ',', ' ') }}{{ p.unitName ? ' ' ~ p.unitName : '' }}
                                    </span>
                                {% endif %}
                                {% if p.leadMinutes > 0 %}
                                    <span>{{ icons.svg('timer', 13) }}
                                        {{ translations.prod_lead | default('Cuisson') }}
                                        {{ p.leadMinutes }} {{ translations.prod_unit_min | default('min') }}
                                    </span>
                                {% endif %}
                            </span>
                        </span>

                        {% if line %}
                            {% if line.isValidated %}
                                <span class="pr-row-qty">
                                    <b>{{ line.quantityValidated|number_format(0, ',', ' ') }}</b>
                                    <span>{{ translations.mep_real | default('Réel') }}</span>
                                </span>
                                <span class="pr-pill pill-validated">{{ translations.mep_validated | default('MEP validée') }}</span>
                            {% elseif line.isSkipped %}
                                <span class="pr-pill pill-skipped">{{ translations.mep_skipped | default('Écartée') }}</span>
                            {% else %}
                                <span class="pr-row-qty">
                                    <b>{{ line.quantityPlanned|number_format(0, ',', ' ') }}</b>
                                    <span>{{ translations.mep_planned | default('Prévu') }}</span>
                                </span>
                                <span class="pr-pill pill-pending">{{ translations.mep_pending | default('À valider') }}</span>
                            {% endif %}
                        {% endif %}
                    </a>
                {% endfor %}
            </div>
        </section>
    {% endfor %}
{% endif %}
