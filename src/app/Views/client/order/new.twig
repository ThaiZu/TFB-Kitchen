{% extends "layouts/base.twig" %}

{% set isEditMode = form_mode|default('create') == 'edit' %}

{% block title %}
    {{ isEditMode
        ? translations.edit_client_order | default('Edycja zamówienia')
        : translations.new_client_order | default('Nowe zamówienie')
    }}
{% endblock %}

{% block head %}
<style>
    .action-card {
        border: 0;
        border-radius: 18px;
        box-shadow: 0 1rem 2rem rgba(15, 23, 42, .08);
    }
    .action-card .card-header {
        background: linear-gradient(135deg, #0f172a 0%, #1d4ed8 100%);
        color: #fff;
        border: 0;
        border-radius: 18px 18px 0 0;
    }
    .soft-panel {
        border: 1px solid rgba(15, 23, 42, .08);
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 .75rem 1.5rem rgba(15, 23, 42, .04);
    }
    .client-badge {
        border-radius: 999px;
        padding: .35rem .75rem;
        background: #eef2ff;
        color: #3730a3;
        font-weight: 700;
        font-size: .82rem;
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        max-width: 100%;
    }
    .search-hint {
        font-size: .78rem;
        color: #6c757d;
    }
    .products-panel {
        overflow: visible;
    }
    .products-panel .table-responsive {
        overflow: visible !important;
    }
    .choices {
        position: relative;
    }
    .choices.is-open {
        z-index: 1070;
    }
    .choices__list--dropdown,
    .choices__list[aria-expanded] {
        z-index: 1080;
    }
    .table thead th {
        white-space: nowrap;
    }
</style>
{% endblock %}

{% block page_heading %}
    <div class="page-heading">
        <h3>
            {{ isEditMode
                ? translations.edit_client_order | default('Edycja zamówienia')
                : translations.new_client_order | default('Nowe zamówienie')
            }}
        </h3>
        <p class="text-subtitle text-muted">
            {{ isEditMode
                ? translations.edit_client_order_subtitle | default('Zmień dane zamówienia i zapisz poprawki.')
                : translations.client_order_subtitle | default('Dodaj klienta i od razu złoż zamówienie na tablecie kuchennym.')
            }}
        </p>
    </div>
{% endblock %}

{% block content %}
<div class="row g-4">
    <div class="col-12 col-xl-4">
        <div class="card action-card h-100">
            <div class="card-header">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-person-plus-fill fs-4"></i>
                    <div>
                        <div class="fw-bold">{{ translations.quick_add_client | default('Szybkie dodanie klienta') }}</div>
                        <div class="small opacity-75">{{ translations.quick_add_client_hint | default('Wpisz telefon i e-mail. Pozostałe pola zostaną zapisane jako puste wartości.') }}</div>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <form id="createClientForm" class="d-grid gap-3">
                    <div>
                        <label class="form-label fw-semibold" for="clientPhone">{{ translations.client_phone | default('Telefon') }}</label>
                        <input type="tel" class="form-control form-control-lg" id="clientPhone" name="phone" required autocomplete="tel" placeholder="+48...">
                    </div>
                    <div>
                        <label class="form-label fw-semibold" for="clientEmail">{{ translations.client_email | default('E-mail') }}</label>
                        <input type="email" class="form-control form-control-lg" id="clientEmail" name="email" autocomplete="email" placeholder="{{ translations.optional_placeholder | default('opcjonalnie') }}">
                    </div>
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg" id="addClientBtn">
                            <i class="bi bi-check2-circle me-1"></i>{{ translations.add_client | default('Dodaj klienta') }}
                        </button>
                    </div>
                </form>
                <div id="clientFormMessage" class="mt-3"></div>
                <div class="soft-panel p-3 mt-4">
                    <div class="text-muted small fw-semibold mb-2">{{ translations.current_client | default('Aktualnie wybrany klient') }}</div>
                    <div id="selectedClientLabel" class="client-badge">
                        <i class="bi bi-person-circle"></i>
                        <span>{{ translations.no_client_selected | default('Nie wybrano klienta') }}</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-8">
        <div class="card action-card">
            <div class="card-header">
                    <div class="d-flex align-items-center justify-content-between gap-3 flex-wrap">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-bag-plus fs-4"></i>
                            <div>
                                <div class="fw-bold">{{ translations.order_details | default('Szczegóły zamówienia') }}</div>
                                <div class="small opacity-75">
                                    {{ isEditMode
                                        ? translations.order_edit_details_subtitle | default('Zmień klienta, termin, komentarz lub pozycje zamówienia.')
                                        : translations.order_details_subtitle | default('Wybierz klienta, ustaw termin i dodaj pozycje.')
                                    }}
                                </div>
                            </div>
                        </div>
                        <a href="{{ ROOT }}/orders" class="btn btn-light btn-sm">
                            <i class="bi bi-arrow-left me-1"></i>{{ translations.back_to_orders | default('Wróć do zamówień') }}
                    </a>
                </div>
            </div>
            <div class="card-body">
                <form id="createOrderForm">
                    <div class="row g-3 mb-4">
                        <div class="col-12 col-lg-6">
                            <label class="form-label fw-semibold" for="clientSelect">{{ translations.select_client | default('Wybierz klienta') }}</label>
                            <select class="form-select form-select-lg" id="clientSelect" name="id_client" required>
                                <option value="">{{ translations.select_client | default('Wybierz klienta') }}</option>
                            </select>
                        </div>
                        <div class="col-12 col-lg-6">
                            <label class="form-label fw-semibold" for="pickUpDateTime">{{ translations.pick_up_datetime | default('Termin odbioru') }}</label>
                            <input type="datetime-local" class="form-control form-control-lg" name="pick_up_datetime" id="pickUpDateTime" required>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold" for="orderComment">{{ translations.comment | default('Komentarz') }}</label>
                            <textarea class="form-control" name="comment" rows="2" id="orderComment" placeholder="{{ translations.comment_placeholder | default('Opcjonalny komentarz do zamówienia') }}"></textarea>
                        </div>
                    </div>

                    <div class="soft-panel p-3 mb-3 products-panel">
                        <div class="d-flex align-items-center justify-content-between gap-3 flex-wrap mb-3">
                            <div class="fw-bold">{{ translations.products | default('Produkty') }}</div>
                            <div class="text-muted small">{{ translations.order_value | default('Wartość zamówienia') }}: <span id="orderTotal">0.00</span> {{ constant('APP_CURRENCY_SYMBOL') }}</div>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-bordered align-middle mb-0" id="productsTable">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 36%">{{ translations.product | default('Produkt') }}</th>
                                        <th style="width: 16%">{{ translations.quantity | default('Ilość') }}</th>
                                        <th style="width: 16%">{{ translations.unit_price_short | default('Cena jedn.') }}</th>
                                        <th style="width: 16%">{{ translations.total_price_short | default('Razem') }}</th>
                                        <th style="width: 16%"></th>
                                    </tr>
                                </thead>
                                <tbody id="productRows"></tbody>
                                <tfoot>
                                    <tr>
                                        <td>
                                            <select class="form-select" id="productSelect">
                                                <option value="">{{ translations.select_product | default('Wybierz produkt') }}</option>
                                            </select>
                                        </td>
                                        <td>
                                            <input type="number" class="form-control" id="productQty" min="1" value="1">
                                        </td>
                                        <td>
                                            <input type="number" class="form-control" id="productPrice" step="0.01" readonly>
                                        </td>
                                        <td></td>
                                        <td>
                                            <button type="button" class="btn btn-success w-100" id="addProductBtn">
                                                <i class="bi bi-plus-lg me-1"></i>{{ translations.add | default('Dodaj') }}
                                            </button>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>

                    <div id="clientFormMessage" class="mb-3"></div>
                    <div id="orderFormMessage" class="mb-3"></div>

                    <div class="d-flex flex-wrap gap-2 justify-content-end">
                        <button type="submit" class="btn btn-primary btn-lg px-4" id="submitOrderBtn">
                            <i class="bi bi-send me-1"></i>
                            {{ isEditMode
                                ? translations.save_changes | default('Zapisz zmiany')
                                : translations.submit_order | default('Zapisz zamówienie')
                            }}
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
    const shopId = {{ shop_id|default(0) }};
    const b2bClients = {{ b2b_clients|json_encode|raw }};
    const b2cClients = {{ b2c_clients|json_encode|raw }};
    const products = {{ products|json_encode|raw }};
    const isEditMode = {{ isEditMode ? 'true' : 'false' }};
    const orderData = {{ order_data|default(null)|json_encode|raw }};

    const clientSelect = document.getElementById('clientSelect');
    const productSelect = document.getElementById('productSelect');
    const addProductBtn = document.getElementById('addProductBtn');
    const productRows = document.getElementById('productRows');
    const orderTotal = document.getElementById('orderTotal');
    const clientForm = document.getElementById('createClientForm');
    const orderForm = document.getElementById('createOrderForm');
    const clientFormMessage = document.getElementById('clientFormMessage');
    const orderFormMessage = document.getElementById('orderFormMessage');
    const selectedClientLabel = document.getElementById('selectedClientLabel');

    let clientChoices = null;
    let productChoices = null;

    function clearMessage(target) {
        target.innerHTML = '';
    }

    function showMessage(target, type, message) {
        target.innerHTML = `<div class="alert alert-${type} mb-0">${message}</div>`;
    }

    function normalizeText(value) {
        return String(value ?? '')
            .toLowerCase()
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '')
            .trim();
    }

    function isB2BClient(client) {
        return String(client.is_b2b ?? 0) === '1';
    }

    function getClientName(client) {
        if (isB2BClient(client)) {
            return (client.company_name || `${client.name || ''} ${client.surname || ''}`.trim() || client.phone || '').trim();
        }

        return `${client.name || ''} ${client.surname || ''}`.trim() || client.phone || '';
    }

    function getClientLabel(client) {
        const baseName = getClientName(client) || '{{ translations.client_fallback_name | default("Klient") }}';
        const phone = client.phone ? ` (${client.phone})` : '';
        const nip = client.tax_number ? `, NIP: ${client.tax_number}` : '';
        return `${baseName}${phone}${nip}`;
    }

    function getClientSearchBlob(client) {
        return normalizeText([
            client.phone,
            client.name,
            client.surname,
            client.company_name,
            client.tax_number
        ].filter(Boolean).join(' '));
    }

    function findClientById(id) {
        return [...(b2bClients || []), ...(b2cClients || [])].find(client => String(client.id) === String(id)) || null;
    }

    function buildClientChoiceGroups() {
        const b2bChoices = (b2bClients || []).map(client => ({
            value: String(client.id),
            label: getClientLabel(client),
            customProperties: getClientSearchBlob(client)
        }));

        const b2cChoices = (b2cClients || []).map(client => ({
            value: String(client.id),
            label: getClientLabel(client),
            customProperties: getClientSearchBlob(client)
        }));

        const groups = [];

        if (b2bChoices.length) {
            groups.push({
                label: "{{ translations.type_b2b | default('Firma (B2B)') }}",
                choices: b2bChoices
            });
        }

        if (b2cChoices.length) {
            groups.push({
                label: "{{ translations.type_individual | default('Indywidualny') }}",
                choices: b2cChoices
            });
        }

        return groups;
    }

    function buildProductChoices() {
        return (products || []).map(product => ({
            value: String(product.id),
            label: String(product.name || ''),
            customProperties: normalizeText(product.name)
        }));
    }

    function initClientChoices(selectedValue = '') {
        if (clientChoices) {
            clientChoices.destroy();
        }

        clientSelect.innerHTML = `<option value="">{{ translations.select_client | default('Wybierz klienta') }}</option>`;

        clientChoices = new Choices(clientSelect, {
            searchEnabled: true,
            searchFields: ['label', 'value', 'customProperties'],
            searchPlaceholderValue: '{{ translations.search_client_placeholder | default("Szukaj klienta") }}',
            position: 'bottom',
            shouldSort: false,
            itemSelectText: '',
            placeholder: true,
            placeholderValue: "{{ translations.select_client | default('Wybierz klienta') }}",
            searchResultLimit: 20,
            allowHTML: false
        });

        clientChoices.setChoices(buildClientChoiceGroups(), 'value', 'label', true);

        if (selectedValue) {
            clientChoices.setChoiceByValue(String(selectedValue));
        }

        syncSelectedClientBadge();
    }

    function syncSelectedClientBadge() {
        const selected = findClientById(clientSelect.value);
        if (!selected) {
            selectedClientLabel.innerHTML = '<i class="bi bi-person-circle"></i><span>{{ translations.no_client_selected | default("Nie wybrano klienta") }}</span>';
            return;
        }

        selectedClientLabel.innerHTML = `<i class="bi bi-person-circle"></i><span>${getClientLabel(selected)}</span>`;
    }

    function getProductPrice(product) {
        const price = product.portion_price ?? product.suggested_sale_price ?? 0;
        return parseFloat(price || 0);
    }

    function formatDateTimeLocal(value) {
        if (!value) {
            return '';
        }

        return String(value).replace(' ', 'T').slice(0, 16);
    }

    function initProductChoices(selectedValue = '') {
        if (productChoices) {
            productChoices.destroy();
        }

        productSelect.innerHTML = `<option value="">{{ translations.select_product | default('Wybierz produkt') }}</option>`;

        productChoices = new Choices(productSelect, {
            searchEnabled: true,
            searchFields: ['label', 'value', 'customProperties'],
            searchPlaceholderValue: '{{ translations.search_product_placeholder | default("Szukaj produktu") }}',
            position: 'bottom',
            shouldSort: false,
            itemSelectText: '',
            placeholder: true,
            placeholderValue: "{{ translations.select_product | default('Wybierz produkt') }}",
            searchResultLimit: 20,
            allowHTML: false
        });

        productChoices.setChoices(buildProductChoices(), 'value', 'label', true);

        if (selectedValue) {
            productChoices.setChoiceByValue(String(selectedValue));
        }

        updateProductPrice();
    }

    function updateProductPrice() {
        const productId = productSelect.value;
        const product = (products || []).find(item => String(item.id) === String(productId));
        const price = product ? getProductPrice(product) : 0;
        document.getElementById('productPrice').value = product ? price.toFixed(2) : '';
    }

    function calculateTotal() {
        let total = 0;
        productRows.querySelectorAll('tr').forEach(row => {
            const totalField = row.querySelector('.product-total');
            total += parseFloat(totalField?.value || '0');
        });
        orderTotal.textContent = total.toFixed(2);
    }

    function resetProductControls() {
        if (productChoices) {
            productChoices.removeActiveItems();
            productChoices.clearInput();
        }
        document.getElementById('productQty').value = 1;
        document.getElementById('productPrice').value = '';
        updateProductPrice();
    }

    function addOrUpdateProductRow(productId, productName, unitPrice, quantity) {
        const existingRow = Array.from(productRows.querySelectorAll('tr')).find(row => row.querySelector('.product-id').value === String(productId));
        if (existingRow) {
            const quantityInput = existingRow.querySelector('.product-quantity');
            const totalInput = existingRow.querySelector('.product-total');
            const priceInput = existingRow.querySelector('.product-price');
            const nextQuantity = parseFloat(quantityInput.value || '0') + quantity;
            quantityInput.value = nextQuantity;
            priceInput.value = unitPrice.toFixed(2);
            totalInput.value = (unitPrice * nextQuantity).toFixed(2);
            calculateTotal();
            return;
        }

        const row = document.createElement('tr');
        row.innerHTML = `
            <td>
                <input type="hidden" class="product-id" value="${productId}">
                ${productName}
            </td>
            <td><input type="number" class="form-control product-quantity" value="${quantity}" readonly></td>
            <td><input type="number" class="form-control product-price" value="${unitPrice.toFixed(2)}" readonly></td>
            <td><input type="number" class="form-control product-total" value="${(unitPrice * quantity).toFixed(2)}" readonly></td>
            <td><button type="button" class="btn btn-outline-danger btn-sm w-100 remove-row"><i class="bi bi-x"></i></button></td>
        `;

        row.querySelector('.remove-row').addEventListener('click', () => {
            row.remove();
            calculateTotal();
        });

        productRows.appendChild(row);
        calculateTotal();
    }

    function hydrateOrderForm() {
        if (!orderData) {
            return;
        }

        const selectedClientId = orderData.id_client ? String(orderData.id_client) : '';
        const pickupInput = document.getElementById('pickUpDateTime');
        const commentInput = document.getElementById('orderComment');

        if (pickupInput) {
            pickupInput.value = formatDateTimeLocal(orderData.pick_up_datetime);
        }

        if (commentInput) {
            commentInput.value = orderData.comment || '';
        }

        initClientChoices(selectedClientId);

        (orderData.products || []).forEach(product => {
            addOrUpdateProductRow(
                product.id_product,
                product.name || `#${product.id_product}`,
                parseFloat(product.unit_gross_price || 0),
                parseFloat(product.quantity || 0)
            );
        });

        calculateTotal();
    }

    document.addEventListener('DOMContentLoaded', function () {
        const input = document.getElementById('pickUpDateTime');
        if (input && !isEditMode) {
            const now = new Date();
            const pad = (n) => n.toString().padStart(2, '0');
            const formattedNow = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}T${pad(now.getHours())}:${pad(now.getMinutes())}`;
            input.min = formattedNow;
        }

        initClientChoices();
        initProductChoices();

        if (isEditMode && orderData) {
            hydrateOrderForm();
        }
    });

    clientSelect.addEventListener('change', syncSelectedClientBadge);

    productSelect.addEventListener('change', updateProductPrice);

    addProductBtn.addEventListener('click', function () {
        const selectedOption = productSelect.options[productSelect.selectedIndex];
        const productId = selectedOption.value;
        const productName = selectedOption ? selectedOption.textContent.trim() : '';
        const unitPrice = parseFloat(document.getElementById('productPrice').value);
        const quantity = parseFloat(document.getElementById('productQty').value);

        if (!productId || isNaN(unitPrice) || isNaN(quantity) || quantity <= 0) {
            return;
        }

        addOrUpdateProductRow(productId, productName, unitPrice, quantity);
        resetProductControls();
    });

    clientForm.addEventListener('submit', async function (e) {
        e.preventDefault();
        clearMessage(clientFormMessage);

        const phone = document.getElementById('clientPhone').value.trim();
        const email = document.getElementById('clientEmail').value.trim();

        if (!phone) {
            showMessage(clientFormMessage, 'warning', '{{ translations.client_phone_required | default("Podaj numer telefonu klienta.") }}');
            return;
        }

        const payload = {
            id_main_shop: shopId,
            is_b2b: 0,
            name: '',
            surname: '',
            company_name: '',
            tax_number: '',
            can_deferral: 0,
            street: '',
            street_number: '',
            city: '',
            zip: '',
            comment: '',
            phone,
            email,
            payment_terms: 0,
            personal_discount_percent: 0
        };

        const response = await api('/ajax/clients', {
            method: 'POST',
            data: payload
        });

        if (!response.ok || response.status !== 'success') {
            showMessage(clientFormMessage, 'danger', response.description || response.message || '{{ translations.client_add_error | default("Nie udało się dodać klienta.") }}');
            return;
        }

        const insertedId = response.inserted_id ?? response.data?.inserted_id ?? response.data?.insertedId;
        if (insertedId === null || insertedId === undefined) {
            showMessage(clientFormMessage, 'warning', '{{ translations.client_add_warning | default("Klient został zapisany, ale nie udało się pobrać jego ID.") }}');
            return;
        }

        b2cClients.push({
            id: insertedId,
            is_b2b: 0,
            name: '',
            surname: '',
            company_name: '',
            tax_number: '',
            phone,
            email
        });

        document.getElementById('clientPhone').value = '';
        document.getElementById('clientEmail').value = '';
        initClientChoices(String(insertedId));

        showMessage(clientFormMessage, 'success', '{{ translations.client_add_success | default("Klient został dodany i wybrany do zamówienia.") }}');
    });

    orderForm.addEventListener('submit', async function (e) {
        e.preventDefault();
        clearMessage(orderFormMessage);

        const clientId = clientSelect.value;
        const pickup = document.getElementById('pickUpDateTime').value;
        const comment = document.getElementById('orderComment').value;

        if (!clientId) {
            showMessage(orderFormMessage, 'warning', '{{ translations.select_client_required | default("Wybierz klienta.") }}');
            return;
        }

        const rows = productRows.querySelectorAll('tr');
        if (!rows.length) {
            showMessage(orderFormMessage, 'warning', '{{ translations.select_product_required | default("Dodaj przynajmniej jeden produkt.") }}');
            return;
        }

        const productsData = [];
        rows.forEach(row => {
            const id_product = parseInt(row.querySelector('.product-id').value, 10);
            const quantity = parseFloat(row.querySelector('.product-quantity').value);
            const unit_gross_price = parseFloat(row.querySelector('.product-price').value);
            const total_gross_value_after_discount = parseFloat(row.querySelector('.product-total').value);
            const product = (products || []).find(item => String(item.id) === String(id_product));

            productsData.push({
                id_product,
                name: product ? product.name : row.querySelector('td').textContent.trim(),
                weight: product?.single_weight ?? 0,
                item_discount_value: 0,
                quantity,
                unit_gross_price,
                total_gross_value_after_discount
            });
        });

        const endpoint = isEditMode && orderData && orderData.id
            ? `/ajax/client-orders/${orderData.id}`
            : '/ajax/client-orders';
        const method = isEditMode ? 'PATCH' : 'POST';

        const response = await api(endpoint, {
            method,
            data: {
                id_client: clientId,
                pick_up_datetime: pickup,
                comment,
                products: productsData
            }
        });

        if (!response.ok || response.status !== 'success') {
            showMessage(orderFormMessage, 'danger', response.description || response.message || '{{ translations.order_add_error | default("Nie udało się zapisać zamówienia.") }}');
            return;
        }

        window.location.href = '{{ ROOT }}/orders';
    });
</script>
{% endblock %}
