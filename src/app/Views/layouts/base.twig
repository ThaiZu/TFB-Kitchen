{# layouts/base.twig
   Coque applicative du kitchen : barre supérieure + contenu + feuille de
   navigation + barre d'onglets en bas — le même type de menu que
   pwa_consultant, à la place de la sidebar Mazer.

   Les noms de blocs sont INCHANGÉS (title, head, page_heading, content,
   error_only, scripts) : les vues existantes fonctionnent sans modification.

   `active_nav` est déduit de `current_path` (exposé globalement par
   Controller.php), donc aucune vue n'a à le passer. #}
{% import "components/_icons.twig" as icons %}
{% set p = current_path|default('') %}
{% set active_nav =
    p starts with '/dashboard'  ? 'dashboard'  :
    p starts with '/checklists' ? 'checklists' :
    p starts with '/orders'     ? 'orders'     :
    p starts with '/knowledge'  ? 'knowledge'  :
    p starts with '/complaints' ? 'complaints' :
    p starts with '/me'         ? 'me'         : '' %}
<!DOCTYPE html>
<html lang="{{ lang_code ?? 'pl' }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">

    <title>{% block title %}{{ pageTitle|default('Kitchen') }}{% endblock %}</title>

    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ ROOT }}/assets/css/bootstrap.css">
    <link rel="stylesheet" href="{{ ROOT }}/assets/vendors/perfect-scrollbar/perfect-scrollbar.css">
    <link rel="stylesheet" href="{{ ROOT }}/assets/vendors/bootstrap-icons/bootstrap-icons.css">
    <link rel="stylesheet" href="{{ ROOT }}/assets/css/app.css">
    <link rel="shortcut icon" href="{{ ROOT }}/assets/images/favicon.svg" type="image/x-icon">
    <link rel="stylesheet" href="{{ ROOT }}/assets/css/snackbarStyle.css">
    <link rel="stylesheet" href="{{ ROOT }}/assets/css/custom.css">
    <link rel="stylesheet" href="{{ ROOT }}/assets/vendors/dripicons/webfont.css">
    <link rel="stylesheet" href="{{ ROOT }}/assets/css/pages/dripicons.css">
    <link rel="stylesheet" href="{{ ROOT }}/assets/vendors/choices.js/choices.min.css" />

    <link rel="stylesheet" href="{{ ROOT }}/assets/css/filepond.css">
    <link rel="stylesheet" href="{{ ROOT }}/assets/css/filepond-plugin-image-preview.css">
    <link rel="stylesheet" href="{{ ROOT }}/assets/css/cropper/cropper.css">

    {# Coque (structure) puis design system (habillage) : l'ordre compte. #}
    <link rel="stylesheet" href="{{ ROOT }}/assets/css/app-shell.css">
    <link rel="stylesheet" href="{{ ROOT }}/assets/css/atelier-theme.css">

    <style>
        /* Przykład: Upewnij się, że nie ma limitów w CSS */
        .choices__list--multiple {
            max-height: none;
        }
    </style>

    <!-- DISABLE ENTER ON EVERY PAGE -->
    <script>
        window.addEventListener('keydown',function(e) {
            if (e.keyIdentifier=='U+000A' || e.keyIdentifier=='Enter' || e.keyCode==13) {
                if (e.target.nodeName=='INPUT' && e.target.type=='text') {
                    e.preventDefault();

                    return false;
                }
            }
        }, true);
    </script>

    {% block head %}{% endblock %}
</head>

<body>

{% block topbar %}
    <div class="app-topbar">
        <div class="container">
            <div class="app-topbar-inner">
                {# Même lettrage de marque que pwa_consultant (assets/brand/logo.png),
                   suivi du nom du module — le consultant affiche « Panel consultant »
                   sous le même logo. Les deux apps sont deux modules d'un même
                   écosystème, la marque est commune et seul le module change. #}
                <a href="{{ ROOT }}/dashboard" class="app-brand">
                    <img src="{{ ROOT }}/assets/brand/logo.png" alt="L'Atelier" class="app-brand-logo">
                    <span class="app-brand-module">{{ translations.module_name ?? 'Kitchen' }}</span>
                </a>

                <div class="d-flex align-items-center gap-2">
                    {% block topbar_actions %}{% endblock %}
                    <button class="app-hamburger" id="appHamburger"
                            aria-label="{{ translations.menu ?? 'Menu' }}"
                            aria-expanded="false" aria-controls="appNavSheet">
                        {{ icons.svg('menu') }}
                    </button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

<main class="app-content">
    <div class="container py-3">
        {% block page_heading %}{% endblock %}

        {% include "page_components/alerts.twig" %}

        {% if gate and errs is not empty %}
            {% block error_only %}
                <div class="row mt-4">
                    <div class="col-12 text-center">
                        <a href="{{ error_back_url|default(ROOT ~ '/Dashboard') }}" class="btn btn-secondary">
                            ← {{ translations.back|default('back') }}
                        </a>
                    </div>
                </div>
            {% endblock %}
        {% else %}
            {% block content %}{% endblock %}
        {% endif %}
    </div>
</main>

<div id="snackbar"></div>

{% include "components/app_nav.twig" with { active_nav: active_nav } %}

{# Barre d'onglets — les quatre gestes du quotidien, plus le profil à droite.
   Production est encore en construction : présente pour situer le parcours,
   mais non cliquable. #}
<nav class="app-tabbar-bar" aria-label="{{ translations.menu ?? 'Navigation' }}">
    <a href="{{ ROOT }}/dashboard" class="app-tab {{ active_nav == 'dashboard' ? 'is-active' : '' }}">
        {{ icons.svg('home', 23) }}<span>{{ translations.nav_dashboard ?? 'Pulpit' }}</span>
    </a>
    <span class="app-tab" style="opacity:.4;" aria-disabled="true"
          title="{{ translations.under_construction ?? 'En construction' }}">
        {{ icons.svg('list-checks', 23) }}<span>{{ translations.nav_production ?? 'Production' }}</span>
    </span>
    <a href="{{ ROOT }}/checklists" class="app-tab {{ active_nav == 'checklists' ? 'is-active' : '' }}">
        {{ icons.svg('clipboard-check', 23) }}<span>{{ translations.nav_checklists ?? 'Checklists' }}</span>
    </a>
    <a href="{{ ROOT }}/orders" class="app-tab {{ active_nav == 'orders' ? 'is-active' : '' }}">
        {{ icons.svg('receipt', 23) }}<span>{{ translations.nav_orders ?? 'Commandes' }}</span>
    </a>
    {% set _dn2 = (user.displayName ?? 'K')|trim %}
    {% set _pp = _dn2|split(' ') %}
    <a href="{{ ROOT }}/me" class="app-tab app-tab-profile {{ active_nav == 'me' ? 'is-active' : '' }}">
        <span class="app-tab-avatar" aria-hidden="true">{{ (_pp[0]|first ~ (_pp[1] is defined ? _pp[1]|first : ''))|upper }}</span>
        <span>{{ translations.nav_profile ?? 'Profil' }}</span>
    </a>
</nav>

<script src="{{ ROOT }}/assets/vendors/perfect-scrollbar/perfect-scrollbar.min.js"></script>
<script src="{{ ROOT }}/assets/js/bootstrap.bundle.min.js"></script>
<script src="{{ ROOT }}/assets/js/functions.js"></script>
<script type="module" src="{{ ROOT }}/assets/js/modules.js"></script>
<script src="{{ ROOT }}/assets/vendors/sweetalert2/sweetalert2.all.min.js"></script>
<script src="{{ ROOT }}/assets/vendors/choices.js/choices.min.js"></script>
<script src="{{ ROOT }}/assets/js/cropper/cropper.min.js"></script>

<script>
    function showSnack(resp, message = "") {

        var x = document.getElementById("snackbar");

        if(resp){
            x.innerText = message ?? "success";
            x.style.backgroundColor = '#4cd038';
        } else {
            x.innerText = message;
            x.style.backgroundColor = '#ff6666';
        }
        x.className = "show";

        // After 3 seconds, remove the show class from DIV
        setTimeout(function(){ x.className = x.className.replace("show", ""); }, 3000);
    }

    document.addEventListener('DOMContentLoaded', function () {
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl)
        })
    }, false);

</script>


{% block scripts %}{% endblock %}

</body>
</html>
