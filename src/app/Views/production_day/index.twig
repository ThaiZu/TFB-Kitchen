{% extends 'layouts/base.twig' %}
{% block title %}{{ translations.day_title }}{% endblock %}
{% block head %}<link rel="stylesheet" href="{{ ROOT }}/assets/vendors/choices.js/choices.min.css"><link rel="stylesheet" href="{{ ROOT }}/assets/css/production-day.css?v=8">{% endblock %}
{% block content %}
<div id="production-day" data-root="{{ ROOT }}" data-view="{{ view }}" data-shift="{{ has_shift ? '1' : '0' }}">
<header class="pd-header"><div><h1>{{ translations.day_title }}</h1><p>{{ translations.day_hint }}</p></div></header>
<div class="pd-toolbar">
{% if available %}<strong id="pd-status" role="status" aria-live="polite"></strong>{% endif %}
<form method="get" class="pd-date-form"><label><span class="pd-sr-only">{{ translations.day_date }}</span><input name="date" type="date" value="{{ sheet.date|default('') }}" required></label><button type="submit" aria-label="{{ translations.day_show }}"><span class="pd-control-text">{{ translations.day_show }}</span><span class="pd-control-icon" aria-hidden="true">→</span></button></form>
{% if available %}<button type="button" id="pd-refresh" aria-label="{{ translations.day_refresh }}"><span class="pd-control-text">{{ translations.day_refresh }}</span><span class="pd-control-icon" aria-hidden="true">↻</span></button>{% endif %}
</div>
{% if not available %}<p role="alert">{{ translations.day_unavailable }} {% if api_error == 'KITCHEN_DAY_MIGRATION_REQUIRED' %}{{ translations.day_migration }}{% endif %}</p>
{% else %}
{% if not has_shift %}<p class="pd-warning">{{ translations.day_shift }} <a href="{{ ROOT }}/checklist">{{ translations.day_shift_open }}</a></p>{% endif %}
<nav class="pd-tabs" aria-label="{{ translations.day_title }}"><button type="button" data-page="opening">{{ translations.day_opening }}</button><button type="button" data-page="stock">{{ translations.day_stock }}</button><button type="button" data-page="closing">{{ translations.day_closing }}</button></nav>
<p id="pd-notice" role="status" aria-live="polite"></p>
<section id="pd-body"></section>
<div id="pd-footer" class="pd-footer" hidden></div>
<dialog id="pd-dialog" aria-labelledby="pd-dialog-title"><form id="pd-modal-form"><header><h2 id="pd-dialog-title"></h2><button type="button" id="pd-dialog-cancel" aria-label="{{ translations.day_cancel }}">×</button></header><div id="pd-dialog-body"></div><p id="pd-dialog-error" role="alert"></p><footer><button type="submit" id="pd-dialog-save">{{ translations.day_confirm }}</button></footer></form></dialog>
<script id="pd-seed" type="application/json">{{ sheet|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }}</script>
<script id="pd-translations" type="application/json">{{ translations|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }}</script>
<script src="{{ ROOT }}/assets/vendors/choices.js/choices.min.js" defer></script><script src="{{ ROOT }}/assets/js/production-day.js?v=8" defer></script>
{% endif %}</div>
{% endblock %}
