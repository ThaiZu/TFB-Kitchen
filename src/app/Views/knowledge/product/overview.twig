{% extends 'layouts/base.twig' %}
{% import 'components/_icons.twig' as icons %}
{% block title %}{{ translations.products }}{% endblock %}
{% block head %}<link rel="stylesheet" href="{{ ROOT }}/assets/css/knowledge-products.css?v={{ knowledge_css_version }}">{% endblock %}
{% block page_heading %}<div class="page-heading kp-page-heading"><h3>{{ translations.products }}</h3><p class="text-subtitle text-muted">{{ translations.products_overview_subtitle }}</p></div>{% endblock %}
{% block content %}
{% if catalog_unavailable|default(false) %}<p role="alert">{{ translations.cards_catalog_unavailable }}</p><a href="{{ ROOT }}/knowledge/products">{{ translations.cards_retry }}</a>{% else %}
<section id="knowledgeProducts" data-selected-sector="{{ production_sector_id|default('') }}" data-all="{{ translations.cards_all }}" data-unassigned="{{ translations.cards_unassigned }}" data-no-category="{{ translations.no_category }}" data-total="{{ translations.products_total }}" data-filter-title="{{ translations.cards_filters }}" data-filter-active="{{ translations.cards_active_filters }}">
<div class="kp-filters">
<div class="kp-search-row"><label class="kp-sr-only" for="productSearch">{{ translations.search }}</label><input type="search" id="productSearch" placeholder="{{ translations.search_products }}" autocomplete="off">
<div class="kp-filter-badges kp-life-segments" role="group" aria-label="{{ translations.cards_life }}">{% for life in ['SSL', 'MSL', 'LSL'] %}<button type="button" data-card-filter="life" data-filter-value="{{ life }}" aria-pressed="{{ life == 'SSL' ? 'true' : 'false' }}">{{ life }}</button>{% endfor %}</div></div>
<div class="kp-picker-row" id="kpAdvancedFilters">{% for key,label in {sector:translations.cards_sector,group:translations.cards_group,category:translations.cards_category} %}
<details class="kp-filter-disclosure" data-card-disclosure="{{ key }}"><summary aria-label="{{ label }}: {{ translations.cards_all }}"><span class="kp-picker-label">{{ label }}</span><span class="kp-picker-value">{{ translations.cards_all }}</span></summary><div class="kp-filter-badges kp-filter-options" role="group" aria-label="{{ label }}" data-card-options="{{ key }}"></div></details>
{% endfor %}<button type="button" id="kpFilterClear">{{ translations.cards_clear }}</button></div>
</div>
<div class="kp-list-heading"><h4>{{ translations.products_list }}</h4><span id="productCount" role="status" aria-live="polite"></span></div>
<p id="noResults" role="status" hidden>{{ translations.no_products_found }}</p>
<button type="button" id="kpShowAll" hidden>{{ translations.cards_show_all }}</button>
<div class="kp-grid" id="productsGrid">
{% for product in products %}
<div class="product-item" data-product-id="{{ product.getId() }}" data-product-name="{{ product.getName()|lower }}" data-life="{{ product.getShelfLifeCategory() }}" data-sector-id="{{ product.getSectorId() ?? 'none' }}" data-sector-name="{{ product.getSectorName() }}" data-category-id="{{ product.getIdCategory() ?? 'none' }}" data-category-name="{{ product.getCategoryName() }}" data-groups="{{ product.getCategoryGroups()|json_encode|e('html_attr') }}" {% if product.getShelfLifeCategory() != 'SSL' or (production_sector_id and product.getSectorId() != production_sector_id) %}hidden{% endif %}>
<a href="{{ ROOT }}/knowledge/products/{{ product.getId() }}" class="kp-card">
<div class="kp-photo"><span aria-hidden="true">{{ icons.svg('package',28) }}</span>{% if product.hasMainPhoto() %}<img src="{{ product.getMainPhotoUrl() }}" alt="" loading="lazy" decoding="async">{% endif %}</div>
<div class="kp-info"><p class="kp-name">{{ product.getName() }}</p><span class="kp-cat">{{ product.getCategoryName() ?: translations.no_category }}</span></div>
</a></div>
{% endfor %}
</div></section>
<script src="{{ ROOT }}/assets/js/knowledge-products.js?v={{ knowledge_js_version }}" defer></script>
{% endif %}
{% endblock %}
