{% extends "layouts/base.twig" %}

{% block title %}{{ translations.products|default('Products') }}{% endblock %}

{% block page_heading %}
    <div class="page-heading">
        <h3>{{ translations.products|default('Products') }}</h3>
        <p class="text-subtitle text-muted">{{ translations.products_overview_subtitle|default('Znajdź produkt i przeglądaj jego kartę techniczną') }}</p>

        {# Breadcrumb to show user's location #}
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ ROOT }}">{{ translations.home|default('Home') }}</a></li>
                <li class="breadcrumb-item"><a href="{{ ROOT }}/knowledge">{{ translations.knowledge|default('Knowledge') }}</a></li>
                <li class="breadcrumb-item active" aria-current="page">{{ translations.products|default('Products') }}</li>
            </ol>
        </nav>
    </div>
{% endblock %}

{% block content %}

    {# alerty globalne #}
    {% include "page_components/alerts.twig" %}

    <div class="row">

        {# SEARCH & FILTERS #}
        <div class="col-12 mb-4">
            <div class="card">
                <div class="card-body">
                    <div class="row g-3">

                        {# Search box #}
                        <div class="col-12 col-md-8">
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-primary text-white">
                                    <i class="bi bi-search"></i>
                                </span>
                                <input
                                    type="text"
                                    class="form-control form-control-lg"
                                    id="productSearch"
                                    placeholder="{{ translations.search_products|default('Wyszukaj produkt po nazwie...') }}"
                                    autocomplete="off"
                                >
                            </div>
                            <div class="mt-2 text-muted small">
                                <i class="bi bi-info-circle"></i>
                                {{ translations.search_hint|default('Wpisz nazwę produktu aby szybko go odnaleźć') }}
                            </div>
                        </div>

                        {# Category filter #}
                        <div class="col-12 col-md-4">
                            <label for="categoryFilter" class="form-label fw-bold">
                                <i class="bi bi-funnel"></i> {{ translations.filter_category|default('Filtruj po kategorii') }}
                            </label>
                            <select class="form-select form-select-lg" id="categoryFilter">
                                <option value="">{{ translations.all_categories|default('Wszystkie kategorie') }}</option>
                            </select>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        {# PRODUCTS GRID #}
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="card-title mb-0">{{ translations.products_list|default('Lista produktów') }}</h4>
                    <span class="badge bg-primary" id="productCount">{{ products|length }} {{ translations.products_total|default('produktów') }}</span>
                </div>
                <div class="card-body">

                    {# No results message #}
                    <div id="noResults" class="alert alert-info d-none" role="alert">
                        <i class="bi bi-info-circle me-2"></i>
                        {{ translations.no_products_found|default('Nie znaleziono produktów pasujących do wyszukiwania') }}
                    </div>

                    {# Products grid #}
                    <div class="row g-3" id="productsGrid">
                        {% for product in products %}
                            <div class="col-12 col-sm-6 col-md-4 col-lg-3 product-item"
                                 data-product-id="{{ product.getId() }}"
                                 data-product-name="{{ product.getName()|lower }}"
                                 data-category="{{ product.getCategoryName()|lower }}">
                                <a href="{{ ROOT }}/knowledge/products/{{ product.getId() }}"
                                   class="card h-100 text-decoration-none product-card hover-lift">
                                    <div class="card-body">

                                        {# Product icon/indicator #}
                                        <div class="d-flex justify-content-between align-items-start mb-3">
                                            <div class="avatar avatar-lg bg-light-success">
                                                <i class="bi bi-box-seam text-success fs-4"></i>
                                            </div>

                                            {# Badges #}
                                            <div class="d-flex flex-column gap-1">
                                                {% if product.getIsVegetarian() %}
                                                    <span class="badge bg-success" title="{{ translations.vegetarian|default('Wegetariańskie') }}">
                                                        <i class="bi bi-leaf"></i>
                                                    </span>
                                                {% endif %}
                                                {% if product.getIsPreparedBeforeSales() %}
                                                    <span class="badge bg-warning" title="{{ translations.prepared_before|default('Przygotowane wcześniej') }}">
                                                        <i class="bi bi-clock-history"></i>
                                                    </span>
                                                {% endif %}
                                            </div>
                                        </div>

                                        {# Product name #}
                                        <h5 class="card-title text-dark mb-2 product-name">{{ product.getName() }}</h5>

                                        {# Category #}
                                        <div class="text-muted small mb-3">
                                            <i class="bi bi-tag"></i>
                                            <span class="product-category">{{ product.getCategoryName() ?: translations.no_category|default('Bez kategorii') }}</span>
                                        </div>

                                        {# Quick info #}
                                        <div class="d-flex flex-column gap-1 small text-muted">
                                            {% if product.getStorageName() %}
                                                <div>
                                                    <i class="bi bi-thermometer-half"></i>
                                                    {{ product.getStorageName() }}
                                                </div>
                                            {% endif %}
                                            {% if product.getShelfLifeMinutes() %}
                                                <div>
                                                    <i class="bi bi-clock"></i>
                                                    {{ (product.getShelfLifeMinutes() / 60)|round }} {{ translations.hours|default('godz.') }}
                                                </div>
                                            {% endif %}
                                        </div>

                                        {# View card button #}
                                        <div class="mt-3 pt-3 border-top">
                                            <div class="d-flex align-items-center text-primary">
                                                <span class="fw-semibold small">{{ translations.view_card|default('Zobacz kartę') }}</span>
                                                <i class="bi bi-arrow-right ms-auto"></i>
                                            </div>
                                        </div>

                                    </div>
                                </a>
                            </div>
                        {% endfor %}
                    </div>

                </div>
            </div>
        </div>

    </div>

{% endblock %}

{% block scripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('productSearch');
    const categoryFilter = document.getElementById('categoryFilter');
    const productsGrid = document.getElementById('productsGrid');
    const productItems = document.querySelectorAll('.product-item');
    const noResults = document.getElementById('noResults');
    const productCount = document.getElementById('productCount');

    // Populate category filter
    const categories = new Set();
    productItems.forEach(item => {
        const category = item.getAttribute('data-category');
        if (category && category.trim() !== '') {
            categories.add(category);
        }
    });

    // Sort categories and add to select
    Array.from(categories).sort().forEach(category => {
        const option = document.createElement('option');
        option.value = category;
        option.textContent = category.charAt(0).toUpperCase() + category.slice(1);
        categoryFilter.appendChild(option);
    });

    // Filter function
    function filterProducts() {
        const searchTerm = searchInput.value.toLowerCase().trim();
        const selectedCategory = categoryFilter.value.toLowerCase();
        let visibleCount = 0;

        productItems.forEach(item => {
            const productName = item.getAttribute('data-product-name');
            const productCategory = item.getAttribute('data-category');

            const matchesSearch = !searchTerm || productName.includes(searchTerm);
            const matchesCategory = !selectedCategory || productCategory === selectedCategory;

            if (matchesSearch && matchesCategory) {
                item.style.display = '';
                visibleCount++;
            } else {
                item.style.display = 'none';
            }
        });

        // Update count and show/hide no results message
        productCount.textContent = visibleCount + ' {{ translations.products_total|default("produktów") }}';

        if (visibleCount === 0) {
            noResults.classList.remove('d-none');
        } else {
            noResults.classList.add('d-none');
        }
    }

    // Event listeners
    searchInput.addEventListener('input', filterProducts);
    categoryFilter.addEventListener('change', filterProducts);

    // Focus search on load
    searchInput.focus();
});
</script>
{% endblock %}

