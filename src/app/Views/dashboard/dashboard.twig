{% extends "layouts/base.twig" %}

{% block title %}{{ translations.kitchen_dashboard }}{% endblock %}

{% block page_heading %}
    <div class="page-heading">
        <h3>{{ translations.kitchen_dashboard }}</h3>
        <p class="text-subtitle text-muted">{{ translations.kitchen_dashboard_subtitle }}</p>
    </div>
{% endblock %}

{% block content %}

    {# alerty globalne (wg Twojego wzorca) #}
    {% include "page_components/alerts.twig" %}

    <div class="row">

        {# QUICK ACTIONS #}
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title">{{ translations.quick_actions }}</h4>
                </div>
                <div class="card-body">
                    <div class="row g-3">

                        <div class="col-12 col-md-3">
                            <a href="{{ ROOT }}/production" class="card border shadow-sm h-100 text-decoration-none">
                                <div class="card-body d-flex gap-3 align-items-start">
                                    <div class="avatar avatar-lg">
                                        <span class="avatar-content bg-light-primary">
                                            <i class="bi bi-list-check"></i>
                                        </span>
                                    </div>
                                    <div>
                                        <h5 class="mb-1 text-dark">{{ translations.todays_production }}</h5>
                                        <div class="text-muted small">{{ translations.todays_production_subtitle }}</div>
                                    </div>
                                </div>
                            </a>
                        </div>

                        <div class="col-12 col-md-3">
                            <a href="{{ ROOT }}/cards" class="card border shadow-sm h-100 text-decoration-none">
                                <div class="card-body d-flex gap-3 align-items-start">
                                    <div class="avatar avatar-lg">
                                        <span class="avatar-content bg-light-success">
                                            <i class="bi bi-journal-text"></i>
                                        </span>
                                    </div>
                                    <div>
                                        <h5 class="mb-1 text-dark">{{ translations.production_cards }}</h5>
                                        <div class="text-muted small">{{ translations.production_cards_subtitle }}</div>
                                    </div>
                                </div>
                            </a>
                        </div>

                        <div class="col-12 col-md-3">
                            <a href="{{ ROOT }}/checklists" class="card border shadow-sm h-100 text-decoration-none">
                                <div class="card-body d-flex gap-3 align-items-start">
                                    <div class="avatar avatar-lg">
                                        <span class="avatar-content bg-light-warning">
                                            <i class="bi bi-clipboard-check"></i>
                                        </span>
                                    </div>
                                    <div>
                                        <h5 class="mb-1 text-dark">{{ translations.checklists }}</h5>
                                        <div class="text-muted small">{{ translations.checklists_subtitle }}</div>
                                    </div>
                                </div>
                            </a>
                        </div>

                        <div class="col-12 col-md-3">
                            <a href="{{ ROOT }}/orders" class="card border shadow-sm h-100 text-decoration-none">
                                <div class="card-body d-flex gap-3 align-items-start">
                                    <div class="avatar avatar-lg">
                                        <span class="avatar-content bg-light-info">
                                            <i class="bi bi-truck"></i>
                                        </span>
                                    </div>
                                    <div>
                                        <h5 class="mb-1 text-dark">{{ translations.my_orders }}</h5>
                                        <div class="text-muted small">{{ translations.my_orders_subtitle }}</div>
                                    </div>
                                </div>
                            </a>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        {# STATS #}
        <div class="col-12">
            <div class="row g-3">

                <div class="col-12 col-md-4">
                    <div class="card h-100">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <div class="text-muted small">{{ translations.tasks_todo }}</div>
                                <div class="fs-3 fw-bold">{{ stats.tasks_todo|default(0) }}</div>
                            </div>
                            <i class="bi bi-circle fs-2 text-muted"></i>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-4">
                    <div class="card h-100">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <div class="text-muted small">{{ translations.tasks_in_progress }}</div>
                                <div class="fs-3 fw-bold">{{ stats.tasks_in_progress|default(0) }}</div>
                            </div>
                            <i class="bi bi-arrow-repeat fs-2 text-muted"></i>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-4">
                    <div class="card h-100">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <div class="text-muted small">{{ translations.tasks_completed }}</div>
                                <div class="fs-3 fw-bold">{{ stats.tasks_completed|default(0) }}</div>
                            </div>
                            <i class="bi bi-check-circle fs-2 text-success"></i>
                        </div>
                    </div>
                </div>

            </div>
        </div>

    </div>
{% endblock %}
