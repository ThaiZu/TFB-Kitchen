{% extends "layouts/base.twig" %}

{% block title %}{{ translations.checklists_title | default('Checklisty') }}{% endblock %}

{% block head %}
<style>
    .task-badge {
        display: inline-block;
        padding: .25rem .65rem;
        border-radius: 999px;
        font-size: .75rem;
        font-weight: 600;
        white-space: nowrap;
    }
    .badge-done    { background: #d1e7dd; color: #0f5132; }
    .badge-pending { background: #e2e3e5; color: #41464b; }
    .badge-skipped { background: #fff3cd; color: #664d03; }
    .badge-failed  { background: #f8d7da; color: #842029; }

    .checklist-section { margin-bottom: 2rem; }

    /* ── Choix de la checklist : tuiles, deux par ligne ── */
    .cl-pick-set { border: 0; padding: 0; margin: 1rem 0 0; min-width: 0; }
    .cl-pick-set > legend { float: none; width: auto; font-size: .82rem; margin-bottom: .5rem; }
    .cl-pick {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
    }
    .cl-pick-tile {
        position: relative;
        display: flex; flex-direction: column; gap: 4px;
        padding: 12px 14px;
        border: 1px solid var(--c-line, rgba(36,26,22,.09));
        border-radius: var(--r-md, 13px);
        background: #fff;
        cursor: pointer;
        transition: border-color .15s ease, background .15s ease, transform .1s ease;
        -webkit-tap-highlight-color: transparent;
        min-width: 0;
    }
    .cl-pick-tile:active { transform: scale(.99); }
    /* Le radio pilote l'état mais reste invisible : la tuile entière est la
       cible tactile, pas une pastille de 16 px. */
    .cl-pick-tile input { position: absolute; opacity: 0; pointer-events: none; }
    .cl-pick-tile:has(input:checked),
    .cl-pick-tile.is-active {
        border-color: var(--c-primary, #8D1D2C);
        background: var(--c-primary-soft, #f4dfe2);
    }
    .cl-pick-tile:has(input:focus-visible) {
        outline: 2px solid var(--c-secondary, #F2C9A0);
        outline-offset: 2px;
    }
    .cl-pick-name {
        font-size: .88rem; font-weight: 700; color: var(--c-ink, #241f1c);
        line-height: 1.25; overflow-wrap: anywhere;
    }
    .cl-pick-time { font-size: .72rem; color: var(--c-muted, #7a7168); }
    .cl-pick-bar {
        display: block; height: 5px; border-radius: 3px;
        background: #e6ded3; overflow: hidden; margin-top: 2px;
    }
    .cl-pick-bar > span {
        display: block; height: 100%; border-radius: 3px;
        background: var(--c-primary, #8D1D2C);
    }
    .cl-pick-count { font-size: .7rem; color: var(--c-muted, #7a7168); }

    /* « Toutes » : pleine largeur, hauteur réduite au strict nécessaire. */
    .cl-pick-all {
        grid-column: 1 / -1;
        flex-direction: row; align-items: center; justify-content: center;
        padding: 9px 14px; min-height: 44px;
    }
    .cl-pick-all .cl-pick-name { font-size: .84rem; text-align: center; }

    /* ── Tuiles de tâches ── */
    .tk-list { display: flex; flex-direction: column; gap: 10px; }
    .tk-item {
        background: var(--c-surface, #fff);
        border: 1px solid var(--c-line, rgba(36,26,22,.09));
        border-left: 4px solid var(--c-muted, #7a7168);
        border-radius: var(--r-lg, 18px);
        box-shadow: var(--sh-2);
        padding: 14px 16px;
    }
    /* L'état se lit au liseré avant même le badge : en parcourant la liste,
       on voit ce qui reste à faire sans lire un mot. */
    .tk-item.is-done    { border-left-color: #2D7A3E; }
    .tk-item.is-pending { border-left-color: var(--c-primary, #8D1D2C); }
    .tk-item.is-skipped { border-left-color: #C17A2A; }
    .tk-item.is-failed  { border-left-color: #8D1D2C; }
    .tk-item.is-done { background: #fcfbf9; }

    .tk-head { display: flex; align-items: flex-start; gap: 11px; }
    .tk-num {
        width: 26px; height: 26px; border-radius: 50%; flex-shrink: 0;
        display: flex; align-items: center; justify-content: center;
        background: var(--c-bg-2, #F4EFE8); color: var(--c-muted, #7a7168);
        font-size: .78rem; font-weight: 700;
    }
    /* Le nom de la tâche est ce qu'on vient lire : il prend la largeur au lieu
       de se casser dans une colonne de deux mots. */
    .tk-title {
        flex: 1; min-width: 0;
        font-size: 1rem; font-weight: 600; color: var(--c-ink, #241f1c);
        line-height: 1.4;
    }
    .tk-photo-icon { color: #1F4F6B; font-size: .8rem; }

    .tk-meta { display: flex; flex-wrap: wrap; gap: 7px; margin: 11px 0 0 37px; }
    .tk-chip {
        display: inline-flex; align-items: center; gap: 5px;
        font-size: .78rem; color: var(--c-muted, #7a7168);
        background: var(--c-bg-2, #F4EFE8);
        border: 1px solid var(--c-line, rgba(36,26,22,.09));
        border-radius: 999px; padding: 5px 11px;
    }
    .tk-chip strong { color: var(--c-ink, #241f1c); font-weight: 700; }

    .tk-note {
        display: flex; gap: 7px; margin: 10px 0 0 37px;
        font-size: .85rem; color: #5b524a; line-height: 1.5;
    }
    .tk-note i { color: var(--c-muted, #7a7168); flex-shrink: 0; margin-top: 2px; }

    /* Cocher une tâche est le geste de l'écran : pleine largeur, 48 px. */
    .tk-do {
        display: flex; align-items: center; justify-content: center; gap: 8px;
        width: calc(100% - 37px); margin: 12px 0 0 37px; min-height: 48px;
        border: 0; border-radius: var(--r-md, 13px);
        background: #2D7A3E; color: #fff;
        font-family: inherit; font-size: .95rem; font-weight: 600; cursor: pointer;
        box-shadow: 0 8px 18px -10px rgba(45,122,62,.6);
        -webkit-tap-highlight-color: transparent;
    }
    .tk-do:hover { background: #256633; color: #fff; }
    .tk-do:active { transform: scale(.99); }
    .tk-do i { font-size: 1.1rem; }

    @media (max-width: 520px) {
        .tk-meta, .tk-note { margin-left: 0; }
        .tk-do { width: 100%; margin-left: 0; }
    }

    /* ── Choix de l'employé : badges deux par ligne ── */
    .emp-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 9px; }
    .emp-badge {
        display: flex; align-items: center; gap: 10px;
        min-height: 52px; padding: 8px 12px;
        border: 1px solid var(--c-line-2, rgba(36,26,22,.14));
        border-radius: var(--r-md, 13px);
        background: #fff; cursor: pointer; text-align: left;
        font-family: inherit;
        transition: border-color .15s ease, background .15s ease;
        -webkit-tap-highlight-color: transparent;
    }
    .emp-badge.is-active {
        border-color: var(--c-primary, #8D1D2C);
        background: var(--c-primary-soft, #f4dfe2);
    }
    .emp-initials {
        width: 34px; height: 34px; border-radius: 50%; flex-shrink: 0;
        display: flex; align-items: center; justify-content: center;
        background: var(--c-primary, #8D1D2C); color: #fff;
        font-family: var(--font-display); font-size: .8rem; line-height: 1;
    }
    .emp-name {
        flex: 1; min-width: 0;
        font-size: .88rem; font-weight: 600; color: var(--c-ink, #241f1c);
        line-height: 1.25; overflow-wrap: anywhere;
    }
    .emp-note {
        font-size: .78rem; color: var(--c-muted, #7a7168);
        margin: 9px 0 0; display: flex; gap: 6px; align-items: flex-start;
    }

    /* ── PIN : quatre cases ── */
    #modalNoteInput { resize: vertical; min-height: 62px; }

    /* ── Bandeau de poste ──
       Vert et permanent : on ne tape plus son code, il faut donc voir en
       continu sous quel nom on signe. */
    .shift-bar {
        display: flex; align-items: center; gap: 13px;
        background: var(--c-surface, #fff);
        border: 2px solid var(--c-vert, #2D7A3E);
        border-radius: var(--r-lg, 18px);
        padding: 11px 16px; margin-bottom: 14px;
    }
    .shift-av {
        width: 38px; height: 38px; flex: none; border-radius: 50%;
        background: var(--c-vert, #2D7A3E); color: #fff;
        display: flex; align-items: center; justify-content: center;
        font-size: .84rem; font-weight: 800;
    }
    .shift-txt { flex: 1; min-width: 0; }
    .shift-txt b { display: block; font-size: .95rem; font-weight: 800; line-height: 1.2; }
    .shift-txt small { display: block; font-size: .76rem; color: var(--c-muted, #7a7168); }
    .shift-x {
        flex: none; min-height: 44px; padding: 0 17px;
        border: 1px solid var(--c-line, rgba(36,26,22,.15)); border-radius: 999px;
        background: #fff; color: var(--c-primary, #8D1D2C);
        font-size: .82rem; font-weight: 700;
    }

    .pin-boxes { display: flex; gap: 10px; }
    .pin-box {
        width: 56px; height: 60px; flex: 0 0 auto;
        border: 1px solid var(--c-line-2, rgba(36,26,22,.14));
        border-radius: var(--r-md, 13px);
        background: #fff; text-align: center;
        font-size: 1.5rem; font-weight: 700; color: var(--c-ink, #241f1c);
        font-family: inherit;
    }
    .pin-box:focus {
        outline: none;
        border-color: var(--c-secondary, #F2C9A0);
        box-shadow: 0 0 0 .22rem rgba(141,29,44,.14);
    }
    .pin-box.is-filled { border-color: var(--c-primary, #8D1D2C); }

    .task-mandatory-icon { color: #e0a000; font-size: .75rem; }

    .summary-stat {
        text-align: center;
        padding: .75rem 1rem;
    }
    .summary-stat .stat-value {
        font-size: 1.5rem;
        font-weight: 800;
        line-height: 1.1;
    }
    .summary-stat .stat-label {
        font-size: .75rem;
        color: #6c757d;
        text-transform: uppercase;
        letter-spacing: .04em;
    }
    .stat-total  { color: var(--c-encre, #1F4F6B); }
    .stat-done   { color: var(--c-vert, #2D7A3E); }
    .stat-missed { color: var(--c-primary, #8D1D2C); }

    .progress-bar-thin { height: 6px; border-radius: 3px; }
</style>
{% endblock %}

{% block page_heading %}
    <div class="page-heading">
        <h3>{{ translations.checklists_title | default('Checklisty') }}</h3>
        <p class="text-subtitle text-muted">{{ translations.checklists_subtitle | default('Przeglądaj zadania dzienne zgrupowane według checklisty.') }}</p>
    </div>
{% endblock %}

{% block content %}

    {# ── Panel filtrów ── #}
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <form method="GET" action="{{ ROOT }}/checklists" id="filterForm">
                        <div class="row g-3 align-items-end">

                            {# Data #}
                            <div class="col-12 col-md-8">
                                <label for="dateInput" class="form-label fw-semibold">
                                    {{ translations.filter_date | default('Data') }}
                                </label>
                                <input type="date"
                                       name="date"
                                       id="dateInput"
                                       class="form-control"
                                       value="{{ selected_date }}"
                                       max="{{ today }}"
                                       required>
                            </div>

                            <div class="col-12 col-md-4">
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="bi bi-funnel me-1"></i>
                                    {{ translations.filter_apply | default('Pokaż') }}
                                </button>
                            </div>
                        </div>

                        {# ── Checklista ──
                           Une liste déroulante cachait les checklists derrière un
                           tap et n'en montrait qu'une à la fois : impossible de
                           comparer l'avancement d'un coup d'œil. Des tuiles, deux
                           par ligne, montrent tout — nom, heure, avancement.
                           Chaque tuile porte un radio, donc le formulaire et son
                           bouton continuent de fonctionner sans JavaScript ; le
                           script ne fait qu'éviter le second tap. #}
                        <fieldset class="cl-pick-set">
                            <legend class="form-label fw-semibold">
                                {{ translations.filter_checklist | default('Checklista') }}
                            </legend>

                            <div class="cl-pick">
                                {# « Toutes » n'a ni heure ni avancement à montrer : en tuile
                                   carrée elle laissait un grand vide à côté des autres. Elle
                                   prend la ligne entière, en bandeau fin. #}
                                <label class="cl-pick-tile cl-pick-all {{ selected_checklist_id is empty ? 'is-active' : '' }}">
                                    <input type="radio" name="checklist_id" value=""
                                           {{ selected_checklist_id is empty ? 'checked' : '' }}>
                                    <span class="cl-pick-name">
                                        {{ translations.filter_checklist_all | default('— wszystkie —') }}
                                    </span>
                                </label>

                                {% for cl in checklists %}
                                    {% set done = cl.tasks_total > 0 ? (cl.tasks_done / cl.tasks_total * 100)|round : 0 %}
                                    <label class="cl-pick-tile {{ selected_checklist_id == cl.id ? 'is-active' : '' }}">
                                        <input type="radio" name="checklist_id" value="{{ cl.id }}"
                                               {{ selected_checklist_id == cl.id ? 'checked' : '' }}>
                                        <span class="cl-pick-name">{{ cl.name }}</span>
                                        {% if cl.execution_time %}
                                            <span class="cl-pick-time">
                                                <i class="bi bi-clock"></i> {{ cl.execution_time|slice(0,5) }}
                                            </span>
                                        {% endif %}
                                        <span class="cl-pick-bar" aria-hidden="true">
                                            <span style="width:{{ done }}%"></span>
                                        </span>
                                        <span class="cl-pick-count">
                                            {{ cl.tasks_done }}/{{ cl.tasks_total }}
                                            {{ translations.tasks_done_of | default('wyk.') }}
                                        </span>
                                    </label>
                                {% endfor %}
                            </div>
                        </fieldset>
                    </form>
                </div>
            </div>
        </div>
    </div>

    {# ── Wyniki ── #}
    {% if progress is not null and progress.checklist is defined %}

        {# Nagłówek checklisty #}
        <div class="row mb-3">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                            <div>
                                <h4 class="mb-0 fw-bold">{{ progress.checklist.name }}</h4>
                                <div class="text-muted small mt-1">
                                    {% if progress.checklist.execution_time %}
                                        <i class="bi bi-clock me-1"></i>{{ progress.checklist.execution_time|slice(0,5) }} ·
                                    {% endif %}
                                    {{ selected_date }}
                                </div>
                            </div>
                            <div class="d-flex gap-3">
                                <div class="summary-stat">
                                    <div class="stat-value stat-total">{{ progress.summary.total }}</div>
                                    <div class="stat-label">{{ translations.summary_total | default('Łącznie') }}</div>
                                </div>
                                <div class="summary-stat">
                                    <div class="stat-value stat-done">{{ progress.summary.done }}</div>
                                    <div class="stat-label">{{ translations.summary_done | default('Wykonane') }}</div>
                                </div>
                                <div class="summary-stat">
                                    <div class="stat-value stat-missed">{{ progress.summary.not_done }}</div>
                                    <div class="stat-label">{{ translations.summary_not_done | default('Niewykonane') }}</div>
                                </div>
                            </div>
                        </div>

                        {% if progress.summary.total > 0 %}
                            <div class="mt-3">
                                <div class="progress progress-bar-thin">
                                    <div class="progress-bar bg-success"
                                         style="width: {{ (progress.summary.done / progress.summary.total * 100)|round }}%"
                                         aria-valuenow="{{ progress.summary.done }}"
                                         aria-valuemin="0"
                                         aria-valuemax="{{ progress.summary.total }}">
                                    </div>
                                </div>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        {# Lista zadań #}
        {% if progress.tasks is empty %}
            <div class="text-center text-muted py-5">
                <i class="bi bi-clipboard-x" style="font-size:2.5rem;opacity:.3;"></i>
                <p class="mt-3 mb-0">{{ translations.no_tasks | default('Brak zadań dla tej checklisty w wybranym dniu.') }}</p>
            </div>
        {% else %}
            {# ── Tâches ──
               Huit colonnes dans un tableau : sur une tablette tenue en main,
               « Vérifier si le magasin est propre » se cassait sur cinq lignes
               dans une colonne large de deux mots, le nom de l'opérateur était
               tronqué et le reste sortait de l'écran. Chaque tâche est une
               tuile : ce qu'il y a à faire en tête, l'état sur le côté, les
               horaires en dessous, et le bouton d'exécution à portée du pouce. #}
            <div class="tk-list">
                {% for task in progress.tasks %}
                    {% set status = task.status ?? 'PENDING' %}
                    <div class="tk-item is-{{ status|lower }}">

                        <div class="tk-head">
                            <span class="tk-num">{{ loop.index }}</span>
                            <div class="tk-title">
                                {{ task.name }}
                                {% if task.is_mandatory %}
                                    <i class="bi bi-star-fill task-mandatory-icon"
                                       title="{{ translations.mandatory | default('Obowiązkowe') }}"></i>
                                {% endif %}
                                {% if task.requires_photo %}
                                    <i class="bi bi-camera-fill tk-photo-icon"
                                       title="{{ translations.photo_required | default('Wymagane zdjęcie') }}"></i>
                                {% endif %}
                            </div>
                            {% if status == 'DONE' %}
                                <span class="task-badge badge-done">
                                    <i class="bi bi-check-circle-fill me-1"></i>{{ translations.status_done | default('Wykonane') }}
                                </span>
                            {% elseif status == 'SKIPPED' %}
                                <span class="task-badge badge-skipped">
                                    <i class="bi bi-skip-forward-fill me-1"></i>{{ translations.status_skipped | default('Pominięte') }}
                                </span>
                            {% elseif status == 'FAILED' %}
                                <span class="task-badge badge-failed">
                                    <i class="bi bi-x-circle-fill me-1"></i>{{ translations.status_failed | default('Nieudane') }}
                                </span>
                            {% else %}
                                <span class="task-badge badge-pending">
                                    <i class="bi bi-circle me-1"></i>{{ translations.status_pending | default('Oczekuje') }}
                                </span>
                            {% endif %}
                        </div>

                        <div class="tk-meta">
                            {% if task.execution_time %}
                                <span class="tk-chip">
                                    <i class="bi bi-clock"></i>
                                    {{ translations.col_planned_time | default('Planowana godz.') }}
                                    <strong>{{ task.execution_time|slice(0,5) }}</strong>
                                </span>
                            {% endif %}
                            {% if task.completed_at %}
                                <span class="tk-chip">
                                    <i class="bi bi-check2"></i>
                                    {{ translations.col_completed_at | default('Zrealizowane') }}
                                    <strong>{{ task.completed_at|slice(11,5) }}</strong>
                                </span>
                            {% endif %}
                            {% if task.completed_by %}
                                <span class="tk-chip">
                                    <i class="bi bi-person"></i><strong>{{ task.completed_by }}</strong>
                                </span>
                            {% endif %}
                        </div>

                        {% if task.note %}
                            <p class="tk-note">
                                <i class="bi bi-chat-left-text"></i>{{ task.note }}
                            </p>
                        {% endif %}

                        {% if status != 'DONE' and status != 'SKIPPED' %}
                            <button type="button"
                                    class="tk-do btn-complete-task"
                                    data-task-id="{{ task.task_id }}"
                                    data-task-name="{{ task.name }}"
                                    data-date="{{ selected_date }}"
                                    data-requires-photo="{{ task.requires_photo ? '1' : '0' }}">
                                <i class="bi bi-check2"></i>{{ translations.btn_complete | default('Wykonaj') }}
                            </button>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        {% endif %}

    {% elseif checklists is not empty and selected_checklist_id is empty %}

        {# Widok listy checklist bez szczegółów #}
        <div class="row g-3">
            {% for cl in checklists %}
                {% set pct = cl.tasks_total > 0 ? (cl.tasks_done / cl.tasks_total * 100)|round : 0 %}
                <div class="col-12 col-md-6 col-lg-4">
                    <a href="{{ ROOT }}/checklists?date={{ selected_date }}&checklist_id={{ cl.id }}"
                       class="card h-100 shadow-sm border-0 text-decoration-none text-dark">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title fw-bold mb-0">{{ cl.name }}</h5>
                                {% if cl.execution_time %}
                                    <span class="text-muted small ms-2 text-nowrap">
                                        <i class="bi bi-clock me-1"></i>{{ cl.execution_time|slice(0,5) }}
                                    </span>
                                {% endif %}
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-2 small text-muted">
                                <span>{{ cl.tasks_done }} / {{ cl.tasks_total }} {{ translations.tasks_done_of | default('wykonanych') }}</span>
                                <span class="fw-semibold {% if pct == 100 %}text-success{% elseif pct > 0 %}text-warning{% else %}text-secondary{% endif %}">
                                    {{ pct }}%
                                </span>
                            </div>

                            <div class="progress progress-bar-thin">
                                <div class="progress-bar {% if pct == 100 %}bg-success{% elseif pct > 0 %}bg-warning{% else %}bg-secondary{% endif %}"
                                     style="width:{{ pct }}%"></div>
                            </div>
                        </div>
                    </a>
                </div>
            {% endfor %}
        </div>

    {% elseif selected_date and checklists is empty %}
        <div class="text-center text-muted py-5">
            <i class="bi bi-clipboard-x" style="font-size:2.5rem;opacity:.3;"></i>
            <p class="mt-3 mb-0">{{ translations.no_checklists | default('Brak aktywnych checklist dla wybranego dnia.') }}</p>
        </div>
    {% endif %}

{% endblock %}

{% block scripts %}

{# Choisir une tuile envoie le formulaire : un tap au lieu de deux. Sans
   JavaScript, le bouton « Pokaż » reste la voie normale — rien n'est perdu. #}
<script>
(function () {
    var form = document.getElementById('filterForm');
    if (!form) return;
    form.querySelectorAll('.cl-pick-tile input[type="radio"]').forEach(function (r) {
        r.addEventListener('change', function () { form.submit(); });
    });
})();
</script>

{# ── Modal potwierdzenia wykonania zadania ── #}
{# ── La prise de poste ──
   On se déclare une fois, et toute la checklist s'enchaîne. Le bandeau reste
   visible en permanence : c'est la contrepartie de ne plus taper son code à
   chaque tâche — on doit voir d'un coup d'œil sous quel nom on est en train de
   signer, et pouvoir passer la main sans chercher. #}
{% if shift %}
    <div class="shift-bar" id="shiftBar">
        <span class="shift-av">{{ shift.initials }}</span>
        <span class="shift-txt">
            <b>{{ shift.name }}</b>
            <small>{{ translations.shift_signing | default('signe les tâches de cette checklist') }}</small>
        </span>
        <button type="button" class="shift-x" id="shiftClose">
            {{ translations.shift_change | default('Changer') }}
        </button>
    </div>
{% endif %}

<div class="modal fade" id="completeTaskModal" tabindex="-1" aria-labelledby="completeTaskModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="completeTaskModalLabel">
                    {{ translations.modal_complete_title | default('Oznacz zadanie jako wykonane') }}
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3" id="modalTaskName"></p>

                {# ── Qui a fait la tâche ──
                   Une liste déroulante obligeait à deux taps et n'affichait
                   qu'un nom à la fois. Des badges, deux par ligne, montrent
                   toute l'équipe d'un coup — et se visent au doigt.

                   Le select reste dans le document, masqué : le JavaScript qui
                   lit #modalEmployeeSelect et envoie le formulaire fonctionne
                   sans être réécrit. #}
                {# Poste ouvert : ni nom, ni code. C'est tout l'objet de la
                   prise de poste — la tâche se valide d'un geste, et reste
                   attribuée à la personne déclarée en haut de l'écran. #}
                <div class="mb-3{{ shift ? ' d-none' : '' }}" id="modalWhoBlock">
                    <label class="form-label fw-semibold">
                        {{ translations.modal_employee_label | default('Pracownik') }} <span class="text-danger">*</span>
                    </label>

                    {% set on_duty = employees|filter(e => e.on_schedule is same as(true)) %}
                    {% set schedule_known = employees|filter(e => e.on_schedule is not null)|length > 0 %}
                    {% set shown = schedule_known ? on_duty : employees %}

                    <div class="emp-grid">
                        {% for emp in shown %}
                            <button type="button" class="emp-badge" data-emp-id="{{ emp.id }}">
                                <span class="emp-initials">{{ emp.initials ?: '—' }}</span>
                                <span class="emp-name">{{ emp.name }}</span>
                            </button>
                        {% endfor %}
                    </div>

                    {% if shown is empty %}
                        <p class="emp-note">{{ translations.no_employees | default('Aucun employé disponible.') }}</p>
                    {% elseif not schedule_known %}
                        {# Un filtre annoncé mais inopérant tromperait : tant que
                           l'API ne dit pas qui est de service, on montre tout le
                           monde et on l'écrit. #}
                        <p class="emp-note">
                            <i class="bi bi-info-circle"></i>
                            {{ translations.schedule_not_served | default("L'API ne dit pas encore qui est de service : toute l'équipe est proposée.") }}
                        </p>
                    {% endif %}

                    <select id="modalEmployeeSelect" class="visually-hidden" tabindex="-1" aria-hidden="true">
                        <option value=""></option>
                        {% for emp in shown %}
                            <option value="{{ emp.id }}">{{ emp.name }}</option>
                        {% endfor %}
                    </select>
                </div>

                {# La note passe AVANT le PIN : on écrit ce qu'on a constaté,
                   puis on signe. Le PIN en dernier, juste avant le bouton de
                   validation, fait de la saisie du code le geste qui conclut. #}
                <div class="mb-3">
                    <label for="modalNoteInput" class="form-label fw-semibold">
                        {{ translations.modal_note_label | default('Notatka (opcjonalnie)') }}
                    </label>
                    <textarea id="modalNoteInput" class="form-control" rows="2" maxlength="255"></textarea>
                </div>

                {# ── PIN ──
                   Quatre chiffres, quatre cases : on voit ce qu'on a saisi et
                   où on en est. Le champ unique en type=password n'appelait pas
                   le pavé numérique de façon fiable et ne montrait rien. #}
                <div class="mb-1{{ shift ? ' d-none' : '' }}" id="modalPinBlock">
                    <label class="form-label fw-semibold">
                        {{ translations.modal_pin_label | default('PIN') }} <span class="text-danger">*</span>
                    </label>
                    <div class="pin-boxes" id="pinBoxes">
                        {% for i in 1..4 %}
                            <input type="password"
                                   class="pin-box"
                                   inputmode="numeric"
                                   pattern="[0-9]*"
                                   maxlength="1"
                                   autocomplete="off"
                                   aria-label="{{ translations.modal_pin_label | default('PIN') }} {{ i }}">
                        {% endfor %}
                    </div>
                    <input type="hidden" id="modalPinInput">
                </div>

                <div id="modalPhotoSection" class="mb-1 d-none">
                    <label class="form-label fw-semibold">
                        {{ translations.modal_photo_label | default('Zdjęcie') }}
                        <span class="text-danger">*</span>
                    </label>
                    <div class="d-flex gap-2 mb-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="modalOpenCameraBtn">
                            <i class="bi bi-camera me-1"></i>{{ 'Kamera' }}
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="modalClearPhotoBtn">
                            <i class="bi bi-trash me-1"></i>{{ 'Wyczyść' }}
                        </button>
                    </div>
                    <input type="file" id="modalPhotoInput" class="form-control form-control-sm"
                           accept="image/*" capture="environment">
                    <div id="modalCameraWrap" class="mt-2 d-none">
                        <video id="modalCameraVideo" playsinline autoplay
                               style="width:100%;border-radius:8px;background:#000;max-height:220px;object-fit:cover;"></video>
                        <div class="d-flex gap-2 mt-1">
                            <button type="button" class="btn btn-sm btn-primary" id="modalTakePhotoBtn">
                                <i class="bi bi-camera me-1"></i>Zrób zdjęcie
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="modalCloseCameraBtn">
                                <i class="bi bi-x-circle me-1"></i>Zamknij
                            </button>
                        </div>
                        <canvas id="modalPhotoCanvas" style="display:none;"></canvas>
                    </div>
                    <div id="modalPhotoPreview" class="mt-2 d-none">
                        <img id="modalPhotoPreviewImg" alt="Podgląd"
                             style="max-width:100%;border-radius:8px;border:1px solid rgba(0,0,0,.1);">
                    </div>
                    <div class="text-muted small mt-1">
                        {{ translations.modal_photo_hint | default('Zrób zdjęcie lub wybierz plik.') }}
                    </div>
                </div>

                <div id="modalAlertBox" class="alert mt-3 d-none"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    {{ translations.modal_btn_cancel | default('Anuluj') }}
                </button>
                <button type="button" class="btn btn-success" id="modalConfirmBtn">
                    <span id="modalBtnSpinner" class="spinner-border spinner-border-sm me-1 d-none"></span>
                    {{ translations.modal_btn_confirm | default('Zatwierdź') }}
                </button>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    const ROOT = {{ ROOT | json_encode | raw }};
    const translations = {
        complete_success:                  {{ (translations.complete_success | default('Zadanie zostało oznaczone jako wykonane.')) | json_encode | raw }},
        complete_error_invalid_pin:        {{ (translations.complete_error_invalid_pin | default('Nieprawidłowy PIN.')) | json_encode | raw }},
        complete_error_employee_not_found: {{ (translations.complete_error_employee_not_found | default('Nie znaleziono pracownika.')) | json_encode | raw }},
        complete_error_generic:            {{ (translations.complete_error_generic | default('Błąd podczas oznaczania zadania. Spróbuj ponownie.')) | json_encode | raw }},
        complete_error_employee_required:  {{ (translations.complete_error_employee_required | default('Wybierz pracownika.')) | json_encode | raw }},
        complete_error_pin_required:       {{ (translations.complete_error_pin_required | default('Wprowadź PIN.')) | json_encode | raw }},
        complete_error_photo_required:     {{ (translations.complete_error_photo_required | default('To zadanie wymaga zdjęcia. Dodaj zdjęcie przed zatwierdzeniem.')) | json_encode | raw }},
    };

    let currentTaskId       = null;
    let currentTaskDate     = null;
    let currentRequiresPhoto = false;
    let cameraStream        = null;

    const modal          = document.getElementById('completeTaskModal');
    const bsModal        = modal ? new bootstrap.Modal(modal) : null;
    const taskNameEl     = document.getElementById('modalTaskName');
    // Badges d'employés et cases de PIN : ils alimentent #modalEmployeeSelect
    // et #modalPinInput, que la suite du script lit sans modification.
    (function () {
        var grid = document.querySelector('.emp-grid');
        var sel  = document.getElementById('modalEmployeeSelect');
        if (grid && sel) {
            grid.addEventListener('click', function (e) {
                var b = e.target.closest('.emp-badge');
                if (!b) return;
                grid.querySelectorAll('.emp-badge').forEach(function (x) { x.classList.remove('is-active'); });
                b.classList.add('is-active');
                sel.value = b.dataset.empId;
                sel.dispatchEvent(new Event('change', { bubbles: true }));
                // Focus sur la première case du PIN. Différé d'un tour de
                // boucle : Bootstrap replace le focus dans la modale au moment
                // du clic, et le prendrait sinon de vitesse.
                var first = document.querySelector('.pin-box');
                if (first) {
                    setTimeout(function () {
                        first.focus();
                        first.select && first.select();
                    }, 0);
                }
            });
        }

        var boxes  = Array.prototype.slice.call(document.querySelectorAll('.pin-box'));
        var hidden = document.getElementById('modalPinInput');
        if (!boxes.length || !hidden) return;

        function sync() {
            hidden.value = boxes.map(function (b) { return b.value; }).join('');
            boxes.forEach(function (b) { b.classList.toggle('is-filled', b.value !== ''); });
        }
        boxes.forEach(function (box, i) {
            box.addEventListener('input', function () {
                box.value = box.value.replace(/\D/g, '').slice(0, 1);
                sync();
                if (box.value && boxes[i + 1]) boxes[i + 1].focus();
            });
            // Retour arrière sur une case vide : on remonte, sinon on reste
            // coincé au bout du champ.
            box.addEventListener('keydown', function (e) {
                if (e.key === 'Backspace' && !box.value && boxes[i - 1]) {
                    boxes[i - 1].focus();
                    e.preventDefault();
                }
            });
            // Coller un PIN complet doit remplir les quatre cases.
            box.addEventListener('paste', function (e) {
                var t = (e.clipboardData || window.clipboardData).getData('text').replace(/\D/g, '');
                if (!t) return;
                e.preventDefault();
                boxes.forEach(function (b, j) { b.value = t[j] || ''; });
                sync();
                (boxes[Math.min(t.length, 3)] || boxes[3]).focus();
            });
        });
        // Vider les cases à chaque ouverture, comme le faisait le champ unique.
        var modalEl = document.getElementById('completeTaskModal');
        if (modalEl) {
            modalEl.addEventListener('show.bs.modal', function () {
                boxes.forEach(function (b) { b.value = ''; });
                sync();
                var grid2 = document.querySelector('.emp-grid');
                if (grid2) grid2.querySelectorAll('.emp-badge').forEach(function (x) { x.classList.remove('is-active'); });
            });
        }
    })();

    const employeeSel    = document.getElementById('modalEmployeeSelect');
    const pinInput       = document.getElementById('modalPinInput');
    const noteInput      = document.getElementById('modalNoteInput');
    const confirmBtn     = document.getElementById('modalConfirmBtn');
    const spinner        = document.getElementById('modalBtnSpinner');
    const alertBox       = document.getElementById('modalAlertBox');

    // Photo elements
    const photoSection   = document.getElementById('modalPhotoSection');
    const photoInput     = document.getElementById('modalPhotoInput');
    const photoPreview   = document.getElementById('modalPhotoPreview');
    const photoPreviewImg = document.getElementById('modalPhotoPreviewImg');
    const cameraWrap     = document.getElementById('modalCameraWrap');
    const cameraVideo    = document.getElementById('modalCameraVideo');
    const photoCanvas    = document.getElementById('modalPhotoCanvas');
    const openCameraBtn  = document.getElementById('modalOpenCameraBtn');
    const closeCameraBtn = document.getElementById('modalCloseCameraBtn');
    const takePhotoBtn   = document.getElementById('modalTakePhotoBtn');
    const clearPhotoBtn  = document.getElementById('modalClearPhotoBtn');

    function showAlert(message, type) {
        alertBox.className = 'alert alert-' + type + ' mt-3';
        alertBox.textContent = message;
        alertBox.classList.remove('d-none');
    }

    function hideAlert() { alertBox.classList.add('d-none'); }

    function stopCamera() {
        if (cameraStream) {
            cameraStream.getTracks().forEach(t => t.stop());
            cameraStream = null;
        }
        if (cameraVideo) cameraVideo.srcObject = null;
        if (cameraWrap) cameraWrap.classList.add('d-none');
    }

    function showPhotoPreview(file) {
        if (file) {
            photoPreviewImg.src = URL.createObjectURL(file);
            photoPreview.classList.remove('d-none');
        } else {
            photoPreview.classList.add('d-none');
            photoPreviewImg.removeAttribute('src');
        }
    }

    function setInputFile(file) {
        const dt = new DataTransfer();
        dt.items.add(file);
        photoInput.files = dt.files;
        showPhotoPreview(file);
    }

    function resetModal() {
        employeeSel.value = '';
        pinInput.value    = '';
        noteInput.value   = '';
        hideAlert();
        spinner.classList.add('d-none');
        confirmBtn.disabled = false;
        stopCamera();
        if (photoInput) photoInput.value = '';
        showPhotoPreview(null);
    }

    // Otwieranie modalu po kliknięciu "Wykonaj"
    document.addEventListener('click', function (e) {
        const btn = e.target.closest('.btn-complete-task');
        if (!btn) return;

        currentTaskId        = btn.dataset.taskId;
        currentTaskDate      = btn.dataset.date;
        currentRequiresPhoto = btn.dataset.requiresPhoto === '1';
        const taskName       = btn.dataset.taskName || '';

        if (taskNameEl) taskNameEl.textContent = taskName;
        resetModal();

        if (photoSection) {
            if (currentRequiresPhoto) {
                photoSection.classList.remove('d-none');
            } else {
                photoSection.classList.add('d-none');
            }
        }

        bsModal.show();
    });

    // Zmiana pliku przez file input
    if (photoInput) {
        photoInput.addEventListener('change', function () {
            const file = photoInput.files && photoInput.files[0];
            showPhotoPreview(file || null);
        });
    }

    // Kamera — otwórz
    if (openCameraBtn) {
        openCameraBtn.addEventListener('click', async function () {
            if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
                photoInput.click();
                return;
            }
            try {
                cameraStream = await navigator.mediaDevices.getUserMedia({
                    video: { facingMode: { ideal: 'environment' } },
                    audio: false,
                });
                cameraVideo.srcObject = cameraStream;
                cameraWrap.classList.remove('d-none');
            } catch (err) {
                photoInput.click();
            }
        });
    }

    // Kamera — zamknij
    if (closeCameraBtn) {
        closeCameraBtn.addEventListener('click', stopCamera);
    }

    // Kamera — zrób zdjęcie
    if (takePhotoBtn) {
        takePhotoBtn.addEventListener('click', function () {
            const w = cameraVideo.videoWidth;
            const h = cameraVideo.videoHeight;
            if (!w || !h || !cameraStream) return;
            photoCanvas.width  = w;
            photoCanvas.height = h;
            const ctx = photoCanvas.getContext('2d', { alpha: false });
            ctx.drawImage(cameraVideo, 0, 0, w, h);
            photoCanvas.toBlob(function (blob) {
                if (!blob) return;
                const file = new File([blob], 'task_photo_' + Date.now() + '.jpg', { type: 'image/jpeg' });
                setInputFile(file);
                stopCamera();
            }, 'image/jpeg', 0.9);
        });
    }

    // Wyczyść zdjęcie
    if (clearPhotoBtn) {
        clearPhotoBtn.addEventListener('click', function () {
            if (photoInput) photoInput.value = '';
            showPhotoPreview(null);
            stopCamera();
        });
    }

    if (!confirmBtn) return;

    // Le poste ouvert est connu du serveur, qui l'a signé. Cette variable n'est
    // qu'un miroir pour l'écran : la vérité reste côté serveur, où le cookie
    // est vérifié à chaque tâche.
    let SHIFT_OPEN = {{ shift ? 'true' : 'false' }};

    // Passer la main : on referme le poste et on recharge. La tâche suivante
    // redemandera un nom et un code — c'est exactement ce qu'on veut quand
    // quelqu'un d'autre prend le relais.
    const shiftCloseBtn = document.getElementById('shiftClose');
    if (shiftCloseBtn) {
        shiftCloseBtn.addEventListener('click', function () {
            shiftCloseBtn.disabled = true;
            fetch(ROOT + '/ajax/checklists/shift/close', { method: 'POST', credentials: 'same-origin' })
                .then(function () { window.location.reload(); })
                .catch(function () { shiftCloseBtn.disabled = false; });
        });
    }

    confirmBtn.addEventListener('click', async function () {
        hideAlert();

        const employeeId = employeeSel.value;
        const pin        = pinInput.value.trim();
        const note       = noteInput.value.trim();
        const photoFile  = photoInput && photoInput.files && photoInput.files[0]
                            ? photoInput.files[0] : null;

        // Poste ouvert : ni nom ni code à saisir, c'est tout l'objet de la
        // prise de poste. On ne réclame donc pas ce qui n'est plus demandé.
        if (!SHIFT_OPEN) {
            if (!employeeId) {
                showAlert(translations.complete_error_employee_required, 'warning');
                return;
            }
            if (!pin) {
                showAlert(translations.complete_error_pin_required, 'warning');
                return;
            }
        }
        if (currentRequiresPhoto && !photoFile) {
            showAlert(translations.complete_error_photo_required, 'warning');
            return;
        }

        spinner.classList.remove('d-none');
        confirmBtn.disabled = true;

        try {
            // Première tâche du service : on ouvre le poste avec le code saisi.
            // Les tâches suivantes n'en auront plus besoin — le serveur reconnaît
            // le poste par son cookie signé, et le code ne repart jamais sur le
            // réseau.
            if (!SHIFT_OPEN) {
                const body = new URLSearchParams();
                body.append('employee_id', employeeId);
                body.append('pin', pin);
                const r = await fetch(ROOT + '/ajax/checklists/shift', {
                    method: 'POST', credentials: 'same-origin',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: body
                });
                const d = await r.json().catch(function () { return null; });
                if (!d || !d.success) {
                    showAlert(d && d.message === 'invalid_pin'
                        ? translations.complete_error_invalid_pin
                        : translations.complete_error_generic, 'danger');
                    spinner.classList.add('d-none');
                    confirmBtn.disabled = false;
                    return;
                }
                SHIFT_OPEN = true;
            }

            const formData = new FormData();
            formData.append('employee_id', employeeId);
            formData.append('pin',         pin);
            formData.append('date',        currentTaskDate);
            formData.append('note',        note);
            if (photoFile) {
                formData.append('photo', photoFile);
            }

            const response = await fetch(ROOT + '/checklists/tasks/' + currentTaskId + '/complete', {
                method: 'POST',
                body:   formData,
            });

            const data = await response.json();

            if (data.success) {
                bsModal.hide();
                window.location.reload();
            } else {
                const msg = data.message || 'error';
                let displayMsg;
                if (msg === 'invalid_pin') {
                    displayMsg = translations.complete_error_invalid_pin;
                } else if (msg === 'employee_not_found') {
                    displayMsg = translations.complete_error_employee_not_found;
                } else if (msg === 'employee_required') {
                    displayMsg = translations.complete_error_employee_required;
                } else if (msg === 'pin_required') {
                    displayMsg = translations.complete_error_pin_required;
                } else {
                    displayMsg = translations.complete_error_generic;
                }
                showAlert(displayMsg, 'danger');
            }
        } catch (err) {
            showAlert(translations.complete_error_generic, 'danger');
        } finally {
            spinner.classList.add('d-none');
            confirmBtn.disabled = false;
        }
    });

    // Reset modalu po zamknięciu
    if (modal) {
        modal.addEventListener('hidden.bs.modal', function () {
            stopCamera();
            resetModal();
        });
    }
})();
</script>

{% endblock %}
