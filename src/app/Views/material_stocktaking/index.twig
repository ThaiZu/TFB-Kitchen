{% extends 'layouts/base.twig' %}

{% block title %}{{ translations.title }}{% endblock %}
{% block head %}
<style>
    .ms-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;margin-bottom:14px}.ms-head h1{margin:0;font-size:1.45rem;font-weight:800}.ms-head p{margin:4px 0 0;color:var(--c-muted,#766f68);font-size:.9rem}.ms-card{padding:15px;background:#fff;border:1px solid rgba(36,26,22,.12);border-radius:16px}.ms-notice{margin:0 0 12px;padding:12px;border-radius:10px;background:#fff1f1;color:#98262a}.ms-notice--success{background:#edf7ee;color:#236c35}.ms-tabs{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:14px}.ms-tab,.ms-button{min-height:48px;border:1px solid #cfc5bb;border-radius:10px;background:#fff;font:800 .95rem/1 inherit;color:#403831;cursor:pointer}.ms-tab.is-active,.ms-button--primary{border-color:var(--c-primary,#8d1d2c);background:var(--c-primary,#8d1d2c);color:#fff}.ms-button--primary:disabled,.ms-tab:disabled{opacity:.55;cursor:not-allowed}.ms-pane[hidden]{display:none}.ms-field{width:100%;min-height:48px;padding:10px 12px;border:1px solid #cfc5bb;border-radius:10px;background:#fff;color:#302923;font:inherit}.ms-stack{display:grid;gap:10px}.ms-row{display:grid;grid-template-columns:minmax(0,1fr) 176px;gap:10px;align-items:center;padding:10px 0;border-bottom:1px solid rgba(36,26,22,.09)}.ms-row:last-child{border-bottom:0}.ms-name{font-weight:800}.ms-meta{display:block;margin-top:2px;color:#766f68;font-size:.78rem}.ms-quantity{display:grid;grid-template-columns:42px minmax(0,1fr) 42px;align-items:center;gap:5px}.ms-quantity button{height:48px;border:1px solid #cfc5bb;background:#fff;border-radius:8px;font-size:1.35rem}.ms-quantity input{text-align:center;min-width:0;height:48px;border:1px solid #cfc5bb;border-radius:8px;font:700 1.08rem/1 inherit}.ms-actions{display:grid;gap:9px;margin-top:16px}.ms-code-list{display:flex;flex-wrap:wrap;gap:6px}.ms-code{padding:6px 9px;border:1px solid #cfc5bb;border-radius:999px;background:#f8f6f3;font-size:.8rem}.ms-code button{border:0;background:transparent;margin-left:5px;font-weight:800;cursor:pointer}.ms-summary{margin-top:12px;border-top:1px solid rgba(36,26,22,.12);padding-top:12px}.ms-summary table{width:100%;border-collapse:collapse;font-size:.88rem}.ms-summary th,.ms-summary td{padding:8px 4px;border-bottom:1px solid rgba(36,26,22,.08);text-align:left}.ms-summary th:last-child,.ms-summary td:last-child{text-align:right}.ms-help{margin:0;color:#766f68;font-size:.86rem}.ms-filter{display:grid;grid-template-columns:1fr 130px;gap:8px;margin-bottom:10px}@media(max-width:460px){.ms-head h1{font-size:1.25rem}.ms-row{grid-template-columns:minmax(0,1fr) 160px}.ms-filter{grid-template-columns:1fr}}
</style>
{% endblock %}

{% block content %}
<section class="ms-head"><div><h1>{{ translations.title }}</h1><p>{{ translations.subtitle }}</p></div></section>
{% if not available %}
    <p class="ms-notice">{{ translations.unavailable }}</p>
{% else %}
    {% if not has_shift %}<p class="ms-notice">{{ translations.shift_required }}</p>{% endif %}
    <p id="msNotice" class="ms-notice" role="status" aria-live="polite" hidden></p>
    <section class="ms-card">
        <div class="ms-tabs" role="tablist"><button class="ms-tab is-active" type="button" data-pane="scanner" {% if not has_shift %}disabled{% endif %}>{{ translations.scanner }}</button><button class="ms-tab" type="button" data-pane="manual" {% if not has_shift %}disabled{% endif %}>{{ translations.manual }}</button></div>
        <section id="msScanner" class="ms-pane"><div class="ms-stack"><p class="ms-help">{{ translations.scanner_help }}</p><label><span class="visually-hidden">{{ translations.barcode }}</span><input id="msCode" class="ms-field" type="search" inputmode="none" autocomplete="off" placeholder="{{ translations.barcode }}" {% if not has_shift %}disabled{% endif %}></label><button id="msAddCode" class="ms-button" type="button" {% if not has_shift %}disabled{% endif %}>{{ translations.add_code }}</button><div id="msCodes" class="ms-code-list"></div><button id="msPreview" class="ms-button" type="button" {% if not has_shift %}disabled{% endif %}>{{ translations.verify_codes }}</button></div><div id="msPreviewResult" class="ms-summary" hidden></div><div id="msScannerActions" class="ms-actions" hidden><p class="ms-help">{{ translations.scanner_warning }}</p><button id="msSaveScanner" class="ms-button ms-button--primary" type="button">{{ translations.save_stocktaking }}</button></div></section>
        <section id="msManual" class="ms-pane" hidden><p class="ms-help">{{ translations.manual_help }}</p><div class="ms-filter"><input id="msSearch" class="ms-field" type="search" autocomplete="off" placeholder="{{ translations.search }}"><select id="msCategory" class="ms-field"><option value="">{{ translations.all_categories }}</option></select></div><div id="msManualLines"></div><div class="ms-actions"><p class="ms-help">{{ translations.manual_warning }}</p><button id="msSaveManual" class="ms-button ms-button--primary" type="button" {% if not has_shift %}disabled{% endif %}>{{ translations.save_stocktaking }}</button></div></section>
    </section>
{% endif %}
{% endblock %}

{% block scripts %}{% if available %}
<script>
(() => {
 const root={{ ROOT|json_encode|raw }}, messages={{ translations|json_encode(constant('JSON_HEX_TAG'))|raw }}, screen={{ {lines: lines, has_shift: has_shift}|json_encode(constant('JSON_HEX_TAG'))|raw }};
 const tabs=[...document.querySelectorAll('.ms-tab')], scanner=document.getElementById('msScanner'), manual=document.getElementById('msManual'), notice=document.getElementById('msNotice'), code=document.getElementById('msCode'), codes=document.getElementById('msCodes'), preview=document.getElementById('msPreview'), previewResult=document.getElementById('msPreviewResult'), scannerActions=document.getElementById('msScannerActions'), manualLines=document.getElementById('msManualLines'), search=document.getElementById('msSearch'), category=document.getElementById('msCategory');
 const quantityForInput=value=>{const number=Number(value);return Number.isFinite(number)&&number>=0?String(number):'0'};
 let scanned=[], manualQuantities=Object.fromEntries(screen.lines.map(line=>[String(line.id_material),quantityForInput(line.current_quantity)]));
 const show=(text,type='')=>{notice.hidden=false;notice.className=`ms-notice ${type?'ms-notice--'+type:''}`;notice.textContent=text};
 const request=async(path,data)=>{const response=await fetch(root+path,{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},body:JSON.stringify(data)});const result=await response.json();if(!response.ok||result.success!==true){if(result.reason==='shift_required')window.dispatchEvent(new CustomEvent('kitchen:worker-session-expired'));throw result}return result};
 const format=value=>Number(value).toLocaleString(undefined,{maximumFractionDigits:4});
 function renderCodes(){codes.replaceChildren();scanned.forEach((value,index)=>{const tag=document.createElement('span');tag.className='ms-code';tag.textContent=value;const remove=document.createElement('button');remove.type='button';remove.textContent='×';remove.setAttribute('aria-label',messages.remove);remove.onclick=()=>{scanned.splice(index,1);previewResult.hidden=true;scannerActions.hidden=true;renderCodes()};tag.append(remove);codes.append(tag)});}
 function addCode(){const value=code.value.trim();if(!value)return;if(value.length>160){show(messages.invalid_codes,'error');return;}scanned.push(value);code.value='';code.focus();previewResult.hidden=true;scannerActions.hidden=true;renderCodes();}
 function renderManual(){const term=search.value.trim().toLocaleLowerCase(), selected=category.value;manualLines.replaceChildren();screen.lines.filter(line=>(!selected||line.category===selected)&&(!term||line.name.toLocaleLowerCase().includes(term))).forEach(line=>{const row=document.createElement('div');row.className='ms-row';const name=document.createElement('div');name.innerHTML='<span class="ms-name"></span><span class="ms-meta"></span>';name.querySelector('.ms-name').textContent=line.name;name.querySelector('.ms-meta').textContent=`${line.category||messages.uncategorized} · ${line.unit}`;const group=document.createElement('div');group.className='ms-quantity';const minus=document.createElement('button');minus.type='button';minus.textContent='−';const input=document.createElement('input');input.type='number';input.min='0';input.step='0.0001';input.inputMode='decimal';input.value=manualQuantities[String(line.id_material)];input.dataset.materialId=line.id_material;const keep=()=>{manualQuantities[String(line.id_material)]=String(input.value||'');};input.addEventListener('input',keep);const plus=document.createElement('button');plus.type='button';plus.textContent='+';minus.onclick=()=>{input.value=Math.max(0,Number(input.value||0)-1);keep();};plus.onclick=()=>{input.value=Number(input.value||0)+1;keep();};group.append(minus,input,plus);row.append(name,group);manualLines.append(row)});}
 function fillCategories(){[...new Set(screen.lines.map(line=>line.category).filter(Boolean))].sort((a,b)=>a.localeCompare(b)).forEach(name=>{const option=document.createElement('option');option.value=name;option.textContent=name;category.append(option)});}
 tabs.forEach(tab=>tab.addEventListener('click',()=>{tabs.forEach(item=>item.classList.toggle('is-active',item===tab));scanner.hidden=tab.dataset.pane!=='scanner';manual.hidden=tab.dataset.pane!=='manual';}));
 document.getElementById('msAddCode').onclick=addCode;code.addEventListener('keydown',event=>{if(event.key==='Enter'){event.preventDefault();addCode();}});code.focus();
 preview.onclick=async()=>{if(!scanned.length){show(messages.invalid_codes,'error');return;}preview.disabled=true;try{const result=await request('/ajax/material-stocktaking/preview',{codes:scanned});const grouped={};result.items.forEach(item=>{const key=`${item.id_material}:${item.package_size_in_base_unit}:${item.id_unit}`;if(!grouped[key])grouped[key]={...item,quantity:0};grouped[key].quantity+=1;});const table=document.createElement('table');table.innerHTML='<thead><tr><th></th><th></th><th></th></tr></thead><tbody></tbody>';[...table.querySelectorAll('th')].forEach((cell,index)=>cell.textContent=[messages.material,messages.packs,messages.quantity][index]);Object.values(grouped).forEach(item=>{const row=document.createElement('tr');[item.name,format(item.quantity),`${format(item.quantity*item.package_size_in_base_unit)} ${item.unit_name}`].forEach(value=>{const cell=document.createElement('td');cell.textContent=value;row.append(cell)});table.querySelector('tbody').append(row)});previewResult.replaceChildren(table);previewResult.hidden=false;scannerActions.hidden=false;}catch(result){if(result.reason!=='shift_required')show(messages[result.reason]||messages.failed,'error');}finally{preview.disabled=false;}};
 async function save(payload,button){if(!confirm(messages.confirm_save))return;button.disabled=true;try{await request('/ajax/material-stocktaking/save',payload);show(messages.saved,'success');setTimeout(()=>window.location.reload(),600)}catch(result){if(result.reason!=='shift_required')show(messages[result.reason]||messages.failed,'error');button.disabled=false;}}
 document.getElementById('msSaveScanner').onclick=()=>save({type:'scanner',codes:scanned},document.getElementById('msSaveScanner'));
 document.getElementById('msSaveManual').onclick=()=>save({type:'manual',quantities:manualQuantities},document.getElementById('msSaveManual'));
 window.addEventListener('kitchen:worker-session-restored',()=>{screen.has_shift=true;[code,document.getElementById('msAddCode'),preview,document.getElementById('msSaveScanner'),document.getElementById('msSaveManual')].forEach(element=>{element.disabled=false});code.focus();});
 search.addEventListener('input',renderManual);category.addEventListener('change',renderManual);fillCategories();renderManual();renderCodes();
})();
</script>{% endif %}{% endblock %}
