{# webshop/_blocked.twig — pourquoi l'écran ne peut pas s'ouvrir.

   Quatre causes, et elles ne se réparent pas au même endroit : trois dans les
   réglages de la tablette, une chez le franchisé. Dire « non configuré » les
   confondrait toutes et enverrait chercher au mauvais endroit. #}
<div class="card">
    <div class="card-body ws-state">
        <h2>
            {% if webshop_blocker == 'revoked' %}
                {{ translations.webshop_revoked_title }}
            {% else %}
                {{ translations.webshop_not_configured }}
            {% endif %}
        </h2>

        {% if webshop_blocker == 'no_url' %}
            <p>{{ translations.webshop_no_url }}</p>
        {% elseif webshop_blocker == 'bad_url' %}
            <p>{{ translations.webshop_bad_url }}</p>
        {% elseif webshop_blocker == 'no_token' %}
            <p>{{ translations.webshop_no_token }}</p>
        {% elseif webshop_blocker == 'bad_token' %}
            <p>{{ translations.webshop_bad_token }}</p>
        {% elseif webshop_blocker == 'revoked' %}
            {# Révoqué n'est pas « mal configuré » : quelqu'un a retiré l'accès
               de cette tablette, volontairement. Le dire évite de ressaisir dix
               fois un jeton qui ne remarchera pas. #}
            <p>{{ translations.webshop_revoked }}</p>
            <p>{{ translations.webshop_revoked_fix }}</p>
        {% endif %}

        {% if webshop_blocker != 'revoked' %}
            <p>{{ translations.webshop_where }}</p>
        {% endif %}

        <a class="ws-go" href="{{ ROOT }}/me">
            {{ translations.webshop_go_settings }}
        </a>
    </div>
</div>
